{
  "name": "awaketab",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.17.0",
  "engines": {
    "node": ">=22 <23",
    "pnpm": ">=12 <13"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "pnpm --filter site dev",
    "build": "pnpm -r build",
    "test": "pnpm test:unit && pnpm test:site",
    "test:site": "pnpm -F site test",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:e2e:ext": "playwright test -c apps/extension/playwright.config.ts",
    "lint": "node scripts/comments.mjs && prettier --check . --log-level warn && knip && pnpm -F @awaketab/wake -F @awaketab/core build > /dev/null && eslint . && stylelint \"apps/extension/**/*.css\"",
    "format": "prettier --write . --log-level warn",
    "knip": "knip",
    "typecheck": "pnpm -F @awaketab/wake -F @awaketab/core build > /dev/null && pnpm -r typecheck",
    "size": "pnpm -r --if-present size",
    "keys:dev": "node scripts/keys-dev.mjs",
    "keys:prod": "tsx scripts/keys-prod.mts",
    "keys:check": "tsx scripts/check-keys.mts",
    "kv:backup": "tsx scripts/kv/backup.ts",
    "kv:restore": "tsx scripts/kv/restore.ts",
    "kv:reencrypt": "tsx scripts/kv/reencrypt.ts",
    "lighthouse": "lhci autorun"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@lhci/cli": "0.16.0",
    "@playwright/test": "1.63.0",
    "@size-limit/file": "13.0.3",
    "@types/node": "22.20.1",
    "esbuild": "0.28.2",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "happy-dom": "21.0.4",
    "knip": "6.38.0",
    "prettier": "3.9.6",
    "size-limit": "13.0.3",
    "stylelint": "16.26.1",
    "stylelint-config-standard": "39.0.1",
    "stylelint-use-logical-spec": "5.0.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "typescript-eslint": "8.70.0",
    "vitest": "5.1.0"
  }
}
