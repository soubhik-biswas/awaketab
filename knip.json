{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.mjs", "lighthouserc.cjs"],
      "project": ["*.{ts,mjs,cjs}", "scripts/**/*.mjs"],
      "vitest": {
        "config": ["vitest.config.ts", "vitest.functions.config.ts", "vitest.seo.config.ts"]
      },
      "playwright": {
        "config": ["playwright.config.ts"]
      }
    },
    "apps/extension": {
      "entry": ["scripts/*.{mjs,mts}", "test/**/*.test.ts", "e2e/**/*.spec.ts"],
      "project": [
        "entrypoints/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,mts}",
        "test/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "packages/wake": {
      "entry": ["src/adapters/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,vue}", "test/**/*.ts"],
      "vitest": false
    },
    "packages/core": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/site": {
      "entry": [
        "content-collections.ts",
        "open-next.config.ts",
        "worker/sw.ts",
        "scripts/*.{mjs,mts}",
        "**/*.test.{ts,tsx}"
      ],
      "project": ["**/*.{ts,tsx,mjs,mts}"],
      "ignore": ["components/ui/**", "hooks/use-mobile.ts"],
      "ignoreDependencies": [
        "@base-ui/react",
        "@hookform/resolvers",
        "@shadcn/react",
        "date-fns",
        "embla-carousel-react",
        "input-otp",
        "react-day-picker",
        "react-hook-form",
        "react-resizable-panels",
        "recharts",
        "tailwindcss",
        "tw-animate-css"
      ],
      "ignoreIssues": {
        "components/ui/*.tsx": ["exports", "types"]
      }
    }
  },
  "ignoreWorkspaces": ["apps/web"]
}
