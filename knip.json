{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{mjs,mts}", "scripts/kv/*.ts", "lighthouserc.cjs"],
      "project": ["*.{ts,mjs,cjs}", "scripts/**/*.{mjs,mts,ts}"],
      "vitest": {
        "config": ["vitest.config.ts"]
      }
    },
    "apps/extension": {
      "entry": ["scripts/*.{mjs,mts}", "test/**/*.test.ts", "e2e/**/*.spec.ts", "src/next-font.ts"],
      "project": [
        "entrypoints/**/*.{ts,tsx}",
        "src/**/*.{ts,tsx}",
        "scripts/**/*.{mjs,mts}",
        "test/**/*.ts",
        "e2e/**/*.ts"
      ]
    },
    "packages/wake": {
      "entry": ["src/adapters/*.ts", "test/**/*.test.ts"],
      "project": ["src/**/*.{ts,vue}", "test/**/*.ts"],
      "vitest": false
    },
    "packages/core": {
      "entry": ["test/**/*.test.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "apps/site": {
      "entry": [
        "content-collections.ts",
        "open-next.config.ts",
        "worker/sw.ts",
        "scripts/*.{mjs,mts}",
        "**/*.test.{ts,tsx}",
        "e2e/**/*.spec.ts"
      ],
      "project": ["**/*.{ts,tsx,mjs,mts}"],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"],
      "ignoreIssues": {
        "components/ui/*.tsx": ["exports", "types"]
      }
    }
  }
}
