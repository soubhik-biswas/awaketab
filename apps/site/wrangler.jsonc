{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "awaketab-site",
  // Only the custom domains serve the site, so no second indexable copy exists on workers.dev.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "awaketab.com", "custom_domain": true },
    { "pattern": "www.awaketab.com", "custom_domain": true },
  ],
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Inline scripts built from functions (the theme script) must not carry the bundler's __name helper.
  "keep_names": false,
  // Also holds the prerendered pages, which the Worker reads through ASSETS; `env.preview` inherits this.
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "awaketab-site" }],
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_SITE_URL": "https://awaketab.com",
    "PUBLIC_POLAR_SERVER": "production",
  },
  "kv_namespaces": [{ "binding": "LICENSES", "id": "b26283fdee0e49848015daedc60cb678" }],
  "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "awaketab_events" }],
  // Requests per caller and minute; lib/server/ratelimit.ts picks the binding for each route.
  "ratelimits": [
    { "name": "RL_EVENTS", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } },
    { "name": "RL_FEEDBACK", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } },
    { "name": "RL_LICENSE", "namespace_id": "1003", "simple": { "limit": 10, "period": 60 } },
  ],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "awaketab-auth",
      "database_id": "317e090c-ac0a-4d39-b03d-225dffad9d4b",
      "migrations_dir": "migrations",
    },
  ],
  "env": {
    "preview": {
      "name": "awaketab-site-preview",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [{ "pattern": "play.awaketab.com", "custom_domain": true }],
      "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "awaketab-site-preview" }],
      "vars": {
        "PUBLIC_SITE_URL": "https://play.awaketab.com",
        "PUBLIC_POLAR_SERVER": "sandbox",
      },
      "kv_namespaces": [{ "binding": "LICENSES", "id": "e32aa55d1e52487794f44e342ade04c8" }],
      "analytics_engine_datasets": [{ "binding": "EVENTS", "dataset": "awaketab_events_preview" }],
      "ratelimits": [
        { "name": "RL_EVENTS", "namespace_id": "2001", "simple": { "limit": 30, "period": 60 } },
        { "name": "RL_FEEDBACK", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } },
        { "name": "RL_LICENSE", "namespace_id": "2003", "simple": { "limit": 10, "period": 60 } },
      ],
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "awaketab-auth-preview",
          "database_id": "ebc4261d-5759-48e8-b258-fb761517bdb2",
          "migrations_dir": "migrations",
        },
      ],
    },
  },
}
