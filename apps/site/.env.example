# Copy to .dev.vars (wrangler) or .env.local (next dev). Production values are Worker secrets, never committed.

# Sign-in (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional; defaults to PUBLIC_SITE_URL, then the request's origin.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in: Google Cloud console → APIs & Services → Credentials → OAuth client (Web application).
# Redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in: GitHub → Settings → Developer settings → OAuth Apps.
# Callback URL: <site>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Passkeys need no keys: they use AUTH_DB and BETTER_AUTH_SECRET, and the relying party is the BETTER_AUTH_URL
# (or PUBLIC_SITE_URL) host. Apply migrations/0002_passkey.sql with pnpm -F site db:migrate.

# Site
PUBLIC_SITE_URL=http://localhost:3000
# sandbox or production
PUBLIC_POLAR_SERVER=sandbox
# The browser side of the same switch (the Polar customer portal link)
NEXT_PUBLIC_POLAR_SERVER=sandbox

# Polar (payments and licence keys)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
# JSON map of Polar benefit id → plan, e.g. {"<benefit id>":"pro_yearly","<benefit id>":"pro_monthly"}
POLAR_BENEFIT_MAP=
# Polar product ids for the checkout API; without them the sandbox uses its checkout links.
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY=
# Kept for licences bought before monthly replaced pay once; not offered any more.
POLAR_PRODUCT_PRO_LIFETIME=

# Licences: ES256 private JWK (pnpm keys:dev), its version, and the AES-GCM key for stored licence keys (base64, 32 bytes)
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_VER=1
LICENSE_KEY_ENC_KEY=

# Salt for hashing caller addresses in the rate limiter
RATE_LIMIT_SALT=

# Pro (sync, sign-in, checkout) stays off until it launches; docs/plan/PREMIUM-LAUNCH.md lists every step.
NEXT_PUBLIC_PRO_ENABLED=0
