# Copy to .dev.vars (wrangler) or .env.local (next dev). Production values are Worker secrets, never committed.

# Sign-in (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Optional; defaults to PUBLIC_SITE_URL, then the request's origin.
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in: Google Cloud console → APIs & Services → Credentials → OAuth client (Web application).
# Redirect URI: <site>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub sign-in: GitHub → Settings → Developer settings → OAuth Apps.
# Callback URL: <site>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Passkeys need no keys: they use AUTH_DB and BETTER_AUTH_SECRET, and the relying party is the BETTER_AUTH_URL
# (or PUBLIC_SITE_URL) host. Apply migrations/0002_passkey.sql with pnpm -F site db:migrate.

# Site
PUBLIC_SITE_URL=http://localhost:3000
# Set to play for the preview build and production for the production build. A play build stays out of search
# and sends no analytics.
NEXT_PUBLIC_DEPLOY_ENV=
# sandbox or production
PUBLIC_POLAR_SERVER=sandbox
# The browser side of the same switch (the Polar customer portal link)
NEXT_PUBLIC_POLAR_SERVER=sandbox

# Polar (payments and licence keys)
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ORGANIZATION_ID=
# JSON map of Polar benefit id → plan, e.g. {"<benefit id>":"pro_yearly","<benefit id>":"pro_monthly"}
POLAR_BENEFIT_MAP=
# Polar product ids for the checkout API; without them the sandbox uses its checkout links.
POLAR_PRODUCT_PRO_YEARLY=
POLAR_PRODUCT_PRO_MONTHLY=
# Kept for licences bought before monthly replaced pay once; not offered any more.
POLAR_PRODUCT_PRO_LIFETIME=

# Licences: ES256 private JWK (pnpm keys:dev), its version, and the AES-GCM key for stored licence keys (base64, 32 bytes)
LICENSE_SIGNING_KEY=
LICENSE_SIGNING_VER=1
LICENSE_KEY_ENC_KEY=

# Salt for hashing caller addresses: the key of the rate limiter and, with the date, the daily visitor key of the
# analytics. Without it no visitor key is written. The limits themselves are the RL_EVENTS, RL_FEEDBACK and
# RL_LICENSE bindings in wrangler.jsonc; a local server without them counts in memory.
RATE_LIMIT_SALT=

# Pro (sync, sign-in, checkout) stays off until it launches; docs/plan/PREMIUM-LAUNCH.md lists every step.
NEXT_PUBLIC_PRO_ENABLED=0
# Content-page ad slots: 1 draws them. Read at build time, like every NEXT_PUBLIC_ setting.
NEXT_PUBLIC_ADS_ENABLED=0

# Optional. Remove the leading # to use one.
# Announces a maintenance window on /status and in the footer, for example 2:00 PM
# NEXT_PUBLIC_MAINTENANCE_UNTIL=
# 1 logs WCAG 2.2 AA problems found by axe-core in the browser console during development
# NEXT_PUBLIC_AXE=1
# The version sent with feedback; "web" when unset
# NEXT_PUBLIC_APP_VERSION=
# The commit the Worker was built from, reported by /api/health as "version" (its first 12 characters). Read at
# build time. Workers Builds sets WORKERS_CI_COMMIT_SHA, which wins. With neither set, a production build asks git
# and next dev says "dev".
# COMMIT_SHA=
