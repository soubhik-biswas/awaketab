{
  "name": "site",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "node scripts/build-sw.mjs && next build",
    "content": "content-collections build",
    "postinstall": "content-collections build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:preview": "CLOUDFLARE_ENV=preview NEXT_PUBLIC_DEPLOY_ENV=play NEXT_PUBLIC_POLAR_SERVER=sandbox opennextjs-cloudflare build --env preview && wrangler d1 migrations apply AUTH_DB --remote --env preview && opennextjs-cloudflare deploy --env preview",
    "db:migrate": "wrangler d1 migrations apply AUTH_DB --remote",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local"
  },
  "dependencies": {
    "@awaketab/core": "workspace:*",
    "@awaketab/wake": "workspace:*",
    "@better-auth/passkey": "1.7.14",
    "@content-collections/core": "0.15.3",
    "@content-collections/markdown": "0.1.4",
    "@content-collections/next": "0.2.11",
    "@gsap/react": "2.1.2",
    "@opennextjs/cloudflare": "1.20.14",
    "@polar-sh/nextjs": "1.1.0",
    "@polar-sh/sdk": "1.0.2",
    "@pqina/flip": "1.8.4",
    "@serwist/turbopack": "9.5.13",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "gsap": "3.15.0",
    "lucide-react": "0.460.0",
    "motion": "14.9.0",
    "next": "16.4.3",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "screenfull": "6.0.2",
    "serwist": "9.5.13",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "usehooks-ts": "3.1.1",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261030.1",
    "@content-collections/cli": "0.1.9",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "axe-core": "4.13.0",
    "esbuild": "0.28.2",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "wrangler": "4.156.0"
  }
}
