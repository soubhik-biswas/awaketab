{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "selectAction": { "type": "Action.Execute", "verb": "open" },
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${label}", "size": "Small", "isSubtle": true, "wrap": true },
            { "type": "TextBlock", "text": "${digits}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" },
            {
              "type": "TextBlock",
              "text": "${line}",
              "size": "Small",
              "weight": "Bolder",
              "color": "${if(awake, 'Good', 'Default')}",
              "wrap": true
            }
          ]
        },
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "ActionSet",
              "$when": "${live}",
              "actions": [
                { "type": "Action.Execute", "title": "${extend}", "verb": "extend", "style": "positive" },
                { "type": "Action.Execute", "title": "${stop}", "verb": "stop" }
              ]
            }
          ]
        }
      ]
    }
  ]
}
