{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "selectAction": { "type": "Action.Execute", "verb": "${if(live, 'extend', 'open')}" },
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [{ "type": "TextBlock", "text": "${digits}", "size": "ExtraLarge", "weight": "Lighter" }]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            {
              "type": "TextBlock",
              "text": "${pill}",
              "size": "Small",
              "weight": "Bolder",
              "color": "${if(awake, 'Good', 'Default')}",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "${label}",
              "size": "Large",
              "weight": "Bolder",
              "spacing": "Small",
              "wrap": true
            },
            {
              "type": "TextBlock",
              "text": "${ends}",
              "size": "Small",
              "isSubtle": true,
              "spacing": "Small",
              "wrap": true
            }
          ]
        }
      ]
    }
  ]
}
