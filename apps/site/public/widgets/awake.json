{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.6",
  "selectAction": { "type": "Action.Execute", "verb": "open" },
  "verticalContentAlignment": "Center",
  "body": [
    {
      "type": "TextBlock",
      "text": "${digits}",
      "size": "ExtraLarge",
      "weight": "Lighter",
      "horizontalAlignment": "Center"
    },
    {
      "type": "TextBlock",
      "text": "${status}",
      "size": "Small",
      "isSubtle": true,
      "horizontalAlignment": "Center",
      "wrap": true
    }
  ]
}
