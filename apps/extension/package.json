{
  "name": "extension",
  "version": "1.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:test": "AT_EXT_TEST=1 wxt build",
    "zip": "PUBLIC_POLAR_SERVER=production pnpm exec tsx ../../scripts/check-keys.mts && PUBLIC_POLAR_SERVER=production wxt build && PUBLIC_POLAR_SERVER=production pnpm exec tsx ../../scripts/check-keys.mts --dist .output/chrome-mv3 && node scripts/zip.mjs",
    "zip:check": "node scripts/reproducible.mjs",
    "publish:package": "node --import tsx scripts/publish-package.mts",
    "typecheck": "wxt prepare && tsc --noEmit"
  },
  "dependencies": {
    "@awaketab/core": "workspace:*",
    "@awaketab/wake": "workspace:*",
    "@fontsource-variable/bricolage-grotesque": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/ibm-plex-serif": "5.3.0",
    "motion": "14.9.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "wxt": "0.21.4"
  }
}
