---
import BaseLayout from '../../layouts/BaseLayout.astro';
import type { TSceneKey } from '../../lib/scenes';
import Button from '../shell/Button.astro';
import PageHero from './PageHero.astro';

export interface ISystemAction {
  href: string;
  label: string;
  icon?: string;
}

interface Props {
  title: string;
  description: string;
  eyebrow: string;
  h1: string;
  lead: string;
  scene: TSceneKey;
  primary: ISystemAction;
  secondary?: ISystemAction | undefined;
  canonical?: string | undefined;
}

// Offline, maintenance, expired, removed, 404 and 500 share the system hero from the content boards; never indexed.
const { title, description, eyebrow, h1, lead, scene, primary, secondary, canonical } = Astro.props;
---

<BaseLayout title={title} description={description} {...(canonical ? { canonical } : {})} noindex site>
  <main class="at-sp at-sp-system">
    <PageHero eyebrow={eyebrow} h1={h1} lead={lead} scene={scene}>
      <Button slot="actions" variant="primary" size="xl" icon={primary.icon ?? 'play'} href={primary.href}>
        {primary.label}
      </Button>
      {
        secondary && (
          <Button slot="actions" variant="outline" size="xl" icon={secondary.icon} href={secondary.href}>
            {secondary.label}
          </Button>
        )
      }
    </PageHero>
    <slot />
  </main>
</BaseLayout>
