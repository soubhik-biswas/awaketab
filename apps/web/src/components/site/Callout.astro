---
import Lucide from '../icons/Lucide.astro';

type TTone = 'info' | 'warning' | 'lamp';

interface Props {
  tone?: TTone;
  title: string;
  body?: string | undefined;
  html?: string | undefined;
  id?: string | undefined;
  tag?: 'div' | 'aside';
  label?: string | undefined;
  class?: string;
}

const { tone = 'info', title, body, html, id, tag: Tag = 'div', label, class: className } = Astro.props;
const ICON: Record<TTone, string> = { info: 'info', warning: 'triangle-alert', lamp: 'circle-check' };
---

<Tag
  id={id}
  role={Tag === 'div' ? 'note' : undefined}
  class:list={['at-sp-callout', className]}
  data-tone={tone}
  aria-label={label}
>
  <Lucide name={ICON[tone]} size={20} />
  <span class="at-sp-callout-text">
    <strong class="at-sp-callout-t">{title}</strong>
    {html ? <span class="at-sp-body" set:html={html} /> : body && <span class="at-sp-body">{body}</span>}
    <slot />
  </span>
</Tag>
