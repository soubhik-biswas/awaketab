---
import Button from '../shell/Button.astro';

interface Props {
  title: string;
  desc: string;
  href?: string;
  label?: string;
  lang?: string | undefined;
}

const { title, desc, href = '/', label = 'Keep awake now', lang } = Astro.props;
---

<div class="at-sp-cta" data-theme="dark">
  <span class="at-sp-cta-text">
    <strong class="at-sp-cta-t">{title}</strong>
    <span class="at-sp-cta-d">{desc}</span>
  </span>
  <Button variant="primary" size="xl" href={href} icon="play" hreflang={lang}>{label}</Button>
</div>
