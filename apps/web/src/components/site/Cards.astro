---
import type { TBrand } from '../../lib/brands';
import type { TSceneKey } from '../../lib/scenes';
import Brand from '../icons/Brand.astro';
import Lucide from '../icons/Lucide.astro';
import Scene from './Scene.astro';

export interface ICard {
  href: string;
  title: string;
  desc?: string | undefined;
  link: string;
  scene?: TSceneKey | undefined;
  tags?: readonly string[] | undefined;
  brands?: ReadonlyArray<TBrand | null> | undefined;
  lang?: string | undefined;
  label?: string | undefined;
}

interface Props {
  items: readonly ICard[];
  cols?: number;
  level?: 2 | 3;
}

const { items, cols = 3, level = 3 } = Astro.props;
const Tag = level === 2 ? 'h2' : 'h3';
---

<ul class="at-sp-grid" role="list" style={`--at-sp-cols: ${String(Math.min(cols, items.length || 1))}`}>
  {
    items.map((item) => (
      <li class="at-sp-li">
        <a class="at-sp-card" href={item.href} hreflang={item.lang} aria-label={item.label}>
          {item.scene && (
            <span class="at-sp-card-art">
              <Scene scene={item.scene} width={260} decorative />
            </span>
          )}
          <span class="at-sp-card-body">
            {item.brands && item.brands.length > 0 && (
              <span class="at-sp-card-brands" aria-hidden="true">
                {item.brands.map((logo) => (
                  <Brand logo={logo} size={24} />
                ))}
              </span>
            )}
            <Tag class="at-sp-h3">{item.title}</Tag>
            {item.tags && item.tags.length > 0 && (
              <span class="at-sp-card-tags">
                {item.tags.map((tag, i) => (
                  <>
                    {i > 0 && <span aria-hidden="true">·</span>}
                    <span>{tag}</span>
                  </>
                ))}
              </span>
            )}
            {item.desc && <span class="at-sp-body">{item.desc}</span>}
            <span class="at-sp-card-link">
              {item.link}
              <Lucide name="arrow-right" size={16} class="at-flip-rtl" />
            </span>
          </span>
        </a>
      </li>
    ))
  }
</ul>
