---
import PageHero from '../site/PageHero.astro';
import { changelogLongDate } from '../../lib/changelog';

interface Props {
  title: string;
  updated: string;
  effective: string;
  lede: string;
  toc: ReadonlyArray<readonly [id: string, title: string]>;
  other: readonly [label: string, href: string];
  email: string;
  mailto: string;
}
// The legal board: hero with the dates, a chip row of sections, then the sections as prose.
const { title, updated, effective, lede, toc, other, email, mailto } = Astro.props;
---

<main class="at-sp at-legal">
  <PageHero crumbs={[{ href: '/', label: 'AwakeTab' }, { label: title }]} eyebrow="Legal" h1={title} lead={lede}>
    <p slot="meta" class="at-sp-meta">
      <span>Last updated <time datetime={updated}>{changelogLongDate(updated)}</time></span>
      <span>Effective <time datetime={effective}>{changelogLongDate(effective)}</time></span>
    </p>
    <nav class="at-toc" aria-label="On this page">
      <ul class="at-sp-chips" role="list">
        {
          toc.map(([id, label]) => (
            <li>
              <a class="at-sp-chip" href={`#${id}`}>
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </PageHero>

  <article class="at-sp-block">
    <div class="at-sp-prose at-legal-body">
      <slot />
      <p class="at-sp-note">
        Questions: <a href={mailto}>{email}</a> · <a href={other[1]}>{other[0]}</a>
      </p>
    </div>
  </article>
</main>
