---
interface Props {
  id: string;
  title: string;
  summary: string;
}
const { id, title, summary } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-h`} class="at-legal-section">
  <h2 id={`${id}-h`}>{title}</h2>
  <p class="at-legal-short"><strong>In short: </strong>{summary}</p>
  <slot />
</section>
