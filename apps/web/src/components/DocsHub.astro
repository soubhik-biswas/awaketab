---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './site/PageHero.astro';
import Block from './site/Block.astro';
import Cards, { type ICard } from './site/Cards.astro';
import Cta from './site/Cta.astro';
import { t } from '../i18n/load';
import { articleSchema } from '../lib/seo';
import { HUBS } from '../lib/hubs';
import { DOCS_FEATURED, DOCS_GROUPS, DOCS_MORE, DOCS_TILES, readingMinutes } from '../lib/docs-hub';

const hub = HUBS.learn;
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = '/og/learn-en.png';
const canonical = `${site}/learn`;
const title = t('page.hub.learn.title');
const description = t('page.hub.learn.description');
const h1 = t('page.hub.learn.h1');

const english = (entry: { data: { locale: string } }): boolean => entry.data.locale === 'en';
const slugOf = (id: string): string => id.replace(/^en\//u, '');
const entries = new Map<string, CollectionEntry<'learn'>>(
  (await getCollection('learn', english)).map((entry) => [slugOf(entry.id), entry]),
);

interface IDoc {
  href: string;
  slug: string;
  title: string;
  line: string;
  minutes: number | null;
}
const toDoc = (slug: string): IDoc | null => {
  const entry = entries.get(slug);
  if (!entry) return null;
  return {
    href: `/learn/${slug}`,
    slug,
    title: entry.data.h1,
    line: entry.data.description,
    minutes: readingMinutes(entry.body, entry.data),
  };
};
const present = (doc: IDoc | null): doc is IDoc => doc !== null;

const featured = DOCS_FEATURED.map(toDoc).filter(present);
const placed = new Set([...DOCS_FEATURED, ...DOCS_GROUPS.flatMap((group) => group.slugs)]);
const rest = [...entries.keys()].filter((slug) => !placed.has(slug)).sort();
const groups = [...DOCS_GROUPS, { ...DOCS_MORE, slugs: rest }]
  .map((group) => ({ ...group, docs: group.slugs.map(toDoc).filter(present) }))
  .filter((group) => group.docs.length > 0);

const counts = {
  guides: (await getCollection('guides', english)).length,
  vs: (await getCollection('vs', english)).length,
};
const tiles = DOCS_TILES.map((tile) => ({ ...tile, count: counts[tile.kind] }));
const read = (minutes: number): string => `${String(minutes)} min read`;
const docCard = (doc: IDoc): ICard => ({
  href: doc.href,
  title: doc.title,
  desc: doc.line,
  tags: doc.minutes !== null ? [read(doc.minutes)] : [],
  link: t('site.hub.learn.read'),
});
const tileCards: ICard[] = tiles.map((tile) => ({
  href: tile.href,
  title: tile.title,
  desc: tile.line,
  tags: tile.count > 0 ? [`${String(tile.count)} ${tile.unit[tile.count === 1 ? 0 : 1]}`] : [],
  link: tile.title,
}));
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  site
  ogImage={ogImage}
  schema={articleSchema({
    canonical,
    title: h1,
    description,
    locale: 'en',
    image: `${site}${ogImage}`,
    published: '2026-09-09',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: hub.crumb, url: canonical },
    ],
  })}
>
  <main class="at-sp at-docs">
    <PageHero crumbs={[{ href: '/', label: t('app.name') }, { label: hub.crumb }]} eyebrow={t('site.hub.learn.eyebrow')} h1={h1} lead={hub.lead} />
    {
      featured.length > 0 && (
        <Block id="docs-start" h={t('site.hub.learn.start')}>
          <Cards items={featured.map(docCard)} cols={3} />
        </Block>
      )
    }
    {
      groups.map((group) => (
        <Block id={group.id} h={group.title} sub={group.line}>
          <Cards items={group.docs.map(docCard)} cols={3} />
        </Block>
      ))
    }
    <Block id="docs-more" h={t('site.hub.learn.more')}>
      <Cards items={tileCards} cols={2} />
    </Block>
    <Block label={t('site.cta.label')}>
      <Cta title={t('site.cta.title')} desc={t('site.cta.desc')} href="/?preset=pinf&autostart=1" />
    </Block>
  </main>
</BaseLayout>
