---
import { t } from '../../i18n/load';
import Lucide from '../icons/Lucide.astro';

interface Props {
  card?: boolean;
}
const { card = false } = Astro.props;
---

<p class:list={['at-pro-refund', card && 'at-pro-refund-card']} role={card ? 'note' : undefined}>
  <Lucide name="rotate-ccw" size={20} class="at-pro-refund-icon" />
  <span><strong>{t('page.pro.refund.lead')}</strong> {t('page.pro.refund.rest')}</span>
</p>
