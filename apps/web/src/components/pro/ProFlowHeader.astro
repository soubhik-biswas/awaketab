---
import Mark from '../brand/Mark.astro';
import Lucide from '../icons/Lucide.astro';
import { t } from '../../i18n/load';

interface Props {
  step: number;
}
const { step } = Astro.props;
const labels = [1, 2, 3, 4].map((n) => t(`proflow.steps.s${n}`));
---

<header class="at-pro-flow-head">
  <a class="at-pro-flow-brand" href="/pro" aria-label={t('proflow.steps.brand')}>
    <Mark size={30} />
    <strong class="at-pro-flow-word">AwakeTab</strong>
    <span class="at-pro-chip at-pro-chip-lg">Pro</span>
  </a>
  <span class="at-pro-flow-fill"></span>
  <ol class="at-pro-flow-steps" aria-label={t('proflow.steps.label')} data-flow-steps data-step={String(step)}>
    {
      labels.map((label, i) => (
        <li class="at-pro-flow-step" data-i={String(i)} data-done={i < step ? '' : undefined} aria-current={i === step ? 'step' : undefined}>
          <span class="at-pro-flow-dot">
            <Lucide name="check" size={16} class="at-pro-flow-check" />
            <span class="at-pro-flow-n">{i + 1}</span>
          </span>
          <span class="at-pro-flow-label">{label}</span>
          <span class="sr-only at-pro-flow-done">{t('proflow.steps.done')}</span>
        </li>
      ))
    }
  </ol>
  <span class="at-pro-flow-fill"></span>
  <a class="at-button at-button-ghost at-pro-flow-back" href="/">
    <Lucide name="x" size={18} />
    <span class="at-pro-flow-back-label">{t('proflow.steps.back')}</span>
  </a>
</header>
