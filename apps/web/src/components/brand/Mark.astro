---
import { markSvg, type TMarkState } from '../../lib/mark';

interface Props {
  size?: number;
  state?: TMarkState;
  glow?: boolean;
  small?: boolean;
  label?: string;
  class?: string;
}

const { size = 32, state = 'awake', glow, small, label, class: className } = Astro.props;
---

<Fragment
  set:html={markSvg({
    size,
    state,
    ...(glow === undefined ? {} : { glow }),
    ...(small === undefined ? {} : { small }),
    ...(label === undefined ? {} : { label }),
    ...(className === undefined ? {} : { className }),
  })}
/>
