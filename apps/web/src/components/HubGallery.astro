---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './site/PageHero.astro';
import Block from './site/Block.astro';
import Cards, { type ICard } from './site/Cards.astro';
import Cta from './site/Cta.astro';
import { t } from '../i18n/load';
import { articleSchema, itemListSchema, type TSchemaNode } from '../lib/seo';
import { HUBS, type IHubItem } from '../lib/hubs';
import { brandsIn } from '../lib/brands';

interface Props {
  kind: 'vs' | 'guides';
}

const { kind } = Astro.props;
const hub = HUBS[kind];
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = `/og/${kind}-en.png`;
const canonical = `${site}/${kind}`;
const title = t(`page.hub.${kind}.title`);
const description = t(`page.hub.${kind}.description`);
const h1 = t(`page.hub.${kind}.h1`);

type TEntry = Awaited<ReturnType<typeof getCollection<'vs' | 'guides'>>>[number];
const entries = new Map<string, TEntry>();
for (const entry of await getCollection(kind)) {
  if (entry.data.locale === 'en') entries.set(entry.id.replace(/^en\//u, ''), entry);
}

interface IPick {
  href: string;
  name: string;
  title: string;
  tags: readonly string[];
  fix: string;
  pick: string | undefined;
  instead: { who: string; when: string } | undefined;
}

const toCard = (item: IHubItem): IPick | null => {
  const entry = entries.get(item.slug);
  if (!entry) return null;
  const d = entry.data;
  const us = d.compare?.cols.find((col) => col.us)?.name ?? 'AwakeTab';
  const pick = d.picks?.them?.[0]?.title;
  const insteadWhen = d.picks?.us?.[0]?.title;
  return {
    href: `/${kind}/${item.slug}`,
    name: d.crumb ?? d.h1,
    title: d.h1,
    tags: (item.meta ?? []).filter(Boolean),
    fix: d.description,
    pick: pick ?? item.line,
    instead: insteadWhen ? { who: us, when: insteadWhen } : undefined,
  };
};

const listed = new Set(hub.groups.flatMap((g) => g.items.map((i) => i.slug)));
const unlisted = [...entries.keys()].filter((slug) => !listed.has(slug)).sort();
const groups = hub.groups
  .map((group, gi) => {
    const items: IHubItem[] = [
      ...group.items,
      ...(gi === hub.groups.length - 1 ? unlisted.map((slug) => ({ slug })) : []),
    ];
    return { ...group, cards: items.map(toCard).filter((card): card is IPick => card !== null) };
  })
  .filter((group) => group.cards.length > 0);

const base = articleSchema({
  canonical,
  title: h1,
  description,
  locale: 'en',
  image: `${site}${ogImage}`,
  published: '2026-09-09',
  breadcrumbs: [
    { name: 'AwakeTab', url: site },
    { name: hub.crumb, url: canonical },
  ],
});
const schema = {
  ...base,
  '@graph': [
    ...(base['@graph'] as TSchemaNode[]),
    itemListSchema(
      h1,
      groups.flatMap((group) => group.cards.map((card) => ({ name: card.title, url: `${site}${card.href}` }))),
    ),
  ],
};
// Comparisons say when to pick the other tool; fixes say what they fix (comparison and guide hub boards).
const toTile = (card: IPick): ICard => ({
  href: card.href,
  title: kind === 'vs' ? card.name : card.title,
  label: kind === 'vs' ? card.title : undefined,
  tags: card.tags,
  brands: card.tags.flatMap((tag) => brandsIn(tag)),
  desc:
    kind === 'vs'
      ? [card.pick && `${t('page.hub.vs.pick')}: ${card.pick}`, card.instead && `${t('page.hub.vs.instead', { name: card.instead.who })}: ${card.instead.when}`]
          .filter(Boolean)
          .join(' ')
      : card.fix,
  link: t(`page.hub.${kind}.more`),
});
---

<BaseLayout title={title} description={description} canonical={canonical} ogImage={ogImage} schema={schema} site>
  <main class="at-sp at-hub" data-gallery={kind}>
    <PageHero crumbs={[{ href: '/', label: t('app.name') }, { label: hub.crumb }]} eyebrow={t(`site.hub.${kind}.eyebrow`)} h1={h1} lead={hub.lead}>
      {hub.note && <p class="at-sp-small">{hub.note}</p>}
      <slot />
      <nav class="at-sp-jump" aria-label={hub.jumpAria}>
        <ul class="at-sp-chips" role="list">
          {groups.map((group) => (
            <li>
              <a class="at-sp-chip" href={`#${group.id}`}>{group.short}</a>
            </li>
          ))}
        </ul>
      </nav>
    </PageHero>
    {
      groups.map((group) => (
        <Block id={group.id} h={group.title} sub={`${group.line} · ${String(group.cards.length)} ${hub.unit[group.cards.length === 1 ? 0 : 1]}`}>
          <Cards items={group.cards.map(toTile)} cols={3} />
        </Block>
      ))
    }
    <Block label={t('site.cta.label')}>
      <Cta title={t('site.cta.title')} desc={t('site.cta.desc')} href="/?preset=pinf&autostart=1" />
    </Block>
  </main>
</BaseLayout>
