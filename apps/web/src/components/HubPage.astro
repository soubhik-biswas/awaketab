---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from './site/PageHero.astro';
import Block from './site/Block.astro';
import Cards, { type ICard } from './site/Cards.astro';
import Cta from './site/Cta.astro';
import { t } from '../i18n/load';
import { deviceLogos } from '../lib/brands';
import { supportTags } from '../lib/device-support';
import { useCaseScene } from '../lib/scenes';
import { articleSchema } from '../lib/seo';
import { EXTRA, HUBS, MODE_LABEL, PRESET_LABEL, type IHubItem } from '../lib/hubs';
import { CONTENT_KINDS, type TContentKind } from '../lib/content-i18n';

interface Props {
  kind: TContentKind;
}

const { kind } = Astro.props;
const hub = HUBS[kind];
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = `/og/${kind}-en.png`;
const canonical = `${site}/${kind}`;
const title = t(`page.hub.${kind}.title`);
const description = t(`page.hub.${kind}.description`);
const h1 = t(`page.hub.${kind}.h1`);

type TEntry = Awaited<ReturnType<typeof getCollection<TContentKind>>>[number];
const all = new Map<string, TEntry>();
for (const k of CONTENT_KINDS) {
  for (const entry of await getCollection(k)) {
    if (entry.data.locale === 'en') all.set(`/${k}/${entry.id.replace(/^en\//u, '')}`, entry);
  }
}

interface IRow {
  slug: string;
  href: string;
  title: string;
  name: string;
  line: string;
  meta: readonly string[];
  preset: string;
  mode: string;
  browsers: readonly string[];
  os: readonly string[];
}
const toRow = (item: IHubItem): IRow | null => {
  const href = item.slug.startsWith('/') ? item.slug : `/${kind}/${item.slug}`;
  const entry = all.get(href);
  if (!entry) return null;
  const meta =
    item.meta ?? (kind === 'for' ? [PRESET_LABEL[entry.data.preset] ?? '', MODE_LABEL[entry.data.mode] ?? ''] : []);
  const { data } = entry;
  return {
    slug: href.slice(href.lastIndexOf('/') + 1),
    href,
    title: data.h1,
    name: data.crumb ?? data.h1,
    line: item.line ?? data.honestLimit,
    meta: meta.filter(Boolean),
    preset: data.preset,
    mode: data.mode,
    browsers: data.browsers,
    os: data.os,
  };
};
const listed = new Set(hub.groups.flatMap((g) => g.items.map((i) => (i.slug.startsWith('/') ? i.slug : `/${kind}/${i.slug}`))));
const unlisted = [...all.keys()].filter((href) => href.startsWith(`/${kind}/`) && !listed.has(href));
const groups = hub.groups
  .map((group, gi) => {
    const extra = unlisted.filter((href) => {
      const slug = href.slice(kind.length + 2);
      const home = EXTRA[kind]?.[slug];
      return home ? home === group.id : gi === hub.groups.length - 1;
    });
    const rows = [...group.items.map(toRow), ...extra.map((href) => toRow({ slug: href.slice(kind.length + 2) }))].filter(
      (row): row is IRow => row !== null,
    );
    return { ...group, rows };
  })
  .filter((group) => group.rows.length > 0);
// Use cases carry their scene and suggested length (use-case hub board); devices carry their logos and support.
const toCard = (row: IRow): ICard =>
  kind === 'for'
    ? { href: row.href, title: row.title, desc: row.line, tags: row.meta, scene: useCaseScene(row.slug), link: t('page.hub.readGuide') }
    : {
        href: row.href,
        title: row.name,
        desc: row.line,
        tags: supportTags(row.slug, row.browsers, row.os).map((tag) => tag.label),
        brands: deviceLogos(row.slug, row.browsers, row.os),
        link: t('page.hub.readGuide'),
      };
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  ogImage={ogImage}
  site
  schema={articleSchema({
    canonical,
    title: h1,
    description,
    locale: 'en',
    image: `${site}${ogImage}`,
    published: '2026-09-09',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: hub.crumb, url: canonical },
    ],
  })}
>
  <main class="at-sp at-hub" data-hub={kind}>
    <PageHero crumbs={[{ href: '/', label: t('app.name') }, { label: hub.crumb }]} eyebrow={t(`site.hub.${kind}.eyebrow`)} h1={h1} lead={hub.lead}>
      {hub.note && <p class="at-sp-small">{hub.note}</p>}
      <nav class="at-sp-jump" aria-label={hub.jumpAria}>
        <ul class="at-sp-chips" role="list">
          {groups.map((group) => (
            <li>
              <a class="at-sp-chip" href={`#${group.id}`}>{group.short}</a>
            </li>
          ))}
        </ul>
      </nav>
    </PageHero>
    {
      groups.map((group) => (
        <Block id={group.id} h={group.title} sub={`${group.line} · ${String(group.rows.length)} ${hub.unit[group.rows.length === 1 ? 0 : 1]}`}>
          <Cards items={group.rows.map(toCard)} cols={3} />
        </Block>
      ))
    }
    <Block label={t('site.cta.label')}>
      <Cta title={t('site.cta.title')} desc={t('site.cta.desc')} href="/?preset=pinf&autostart=1" />
    </Block>
  </main>
</BaseLayout>
