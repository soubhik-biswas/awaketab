---
import headerCss from '../../styles/header-menus.css?raw';
import iconCss from '../../styles/icon-motion.css?raw';
import { createT } from '../../i18n/load';
import { LOCALES, localePath, type TLocale } from '../../i18n/locales';
import { minifyCss } from '../../lib/article-css';
import Lucide from '../icons/Lucide.astro';
import Mark from '../brand/Mark.astro';
import Button from './Button.astro';
import LangSwitch from './LangSwitch.astro';
import HeaderAdd from './HeaderAdd.astro';
import HeaderMenuGroup from './HeaderMenuGroup.astro';

interface Props {
  locale: TLocale;
  tool?: boolean;
  links?: Partial<Record<TLocale, string>> | undefined;
}

const { locale, tool = false, links: langLinks } = Astro.props;
const t = createT(locale);
// The section the page belongs to, for aria-current (locale prefix stripped: /es/for/cocinar → for).
const parts = Astro.url.pathname.split('/').filter(Boolean);
const own = parts[0] && (LOCALES as readonly string[]).includes(parts[0]) ? parts.slice(1) : parts;
const first = own[0] ?? '';
const path = Astro.url.pathname.replace(/\/$/u, '') || '/';
// Hubs and product pages are English-only routes (docs/00 §7), so every locale links to them.
const english = locale !== 'en';
const links = [
  ['extension', '/extension', t('header.nav.extension')],
  ['pro', '/pro', t('header.nav.pro')],
] as const;
// Tool pages get menu styles from the on-demand sheet, outside the critical CSS.
const css = tool ? '' : minifyCss(headerCss + iconCss);
const home = localePath(locale, '/');
// The board's five site links; Help and Browser support are English-only routes like the hubs.
const site = [
  ['/for', t('site.nav.uses'), first === 'for' && own.length === 1],
  ['/guides', t('site.nav.guides'), first === 'guides'],
  ['/learn/browser-support-matrix', t('site.nav.support'), path === '/learn/browser-support-matrix'],
  ['/help', t('site.nav.help'), first === 'help'],
  ['/pro', t('site.nav.pro'), first === 'pro'],
] as const;
const more = [
  ['/extension', t('header.nav.extension')],
  ['/about', t('site.foot.about')],
  ['/changelog', t('site.foot.changelog')],
] as const;
const themes = [
  ['auto', t('settings.theme.auto')],
  ['light', t('settings.theme.light')],
  ['dark', t('settings.theme.dark')],
] as const;
---

{
  !tool && (
    <>
      {css && <style is:inline set:html={css} />}
      <i class="at-stuck-probe" aria-hidden="true" />
      <header class="at-sh">
        <div class="at-sh-in">
          <a class="at-sh-logo" href={home} aria-label={t('header.home')}>
            <Mark size={30} small />
            <span class="at-sh-word" aria-hidden="true">
              Awake<span>Tab</span>
            </span>
          </a>
          <nav class="at-sh-nav" aria-label={t('site.nav.label')}>
            <ul role="list">
              {site.map(([href, label, current]) => (
                <li>
                  <a class="at-sh-link" href={href} hreflang={english ? 'en' : undefined} aria-current={current ? 'page' : undefined}>
                    {label}
                    {english && <span class="sr-only"> {t('header.nav.english')}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
          <span class="at-sh-fill" />
          <div class="at-sh-lang">
            <LangSwitch locale={locale} links={langLinks} idBase="at-hlang" />
          </div>
          <Button variant="ghost" href="/signin" class="at-sh-signin" hreflang={english ? 'en' : undefined}>
            {t('site.signin')}
          </Button>
          <Button variant="primary" href={home} class="at-sh-cta">
            <span class="at-sh-cta-long">{t('site.cta')}</span>
            <span class="at-sh-cta-short" aria-hidden="true">{t('site.ctaShort')}</span>
          </Button>
          <button
            class="at-button at-button-ghost at-button-icon at-sh-menu at-hm-open"
            type="button"
            popovertarget="at-hm-menu"
            style="anchor-name:--at-hm-menu"
            aria-label={t('header.menu')}
          >
            <Lucide name="menu" size={20} />
          </button>
        </div>
        <div class="at-hm-panel at-hm-menu" id="at-hm-menu" popover style="position-anchor:--at-hm-menu">
          <div class="at-hm-head">
            <p class="at-hm-title">{t('header.menu')}</p>
            <button class="at-button at-button-ghost at-button-icon" type="button" popovertarget="at-hm-menu" popovertargetaction="hide" aria-label={t('header.menu.close')}>
              <Lucide name="x" size={20} />
            </button>
          </div>
          <nav class="at-hm-body" aria-label={t('header.nav')}>
            <ul class="at-hm-links" role="list">
              {[...site, ...more.map(([href, label]) => [href, label, first === href.slice(1)] as const)].map(([href, label, current]) => (
                <li>
                  <a class="at-hm-link" href={href} hreflang={english ? 'en' : undefined} aria-current={current ? 'page' : undefined}>
                    {label}
                    {english && <span class="sr-only"> {t('header.nav.english')}</span>}
                  </a>
                </li>
              ))}
              <li>
                <a class="at-hm-link" href="/signin" hreflang={english ? 'en' : undefined}>
                  {t('site.signin')}
                </a>
              </li>
            </ul>
            <HeaderMenuGroup locale={locale} kind="for" scope="menu" path={path} feature />
            <HeaderMenuGroup locale={locale} kind="on" scope="menu" path={path} />
            <HeaderMenuGroup locale={locale} kind="res" scope="menu" path={path} />
          </nav>
          <button class="at-hm-theme" type="button" data-theme-cycle>
            <span class="at-hm-label">{t('settings.theme')}</span>
            {themes.map(([value, label]) => (
              <span class="at-hm-theme-v" data-v={value}>{label}</span>
            ))}
            <span class="sr-only">. {t('header.theme.change')}</span>
          </button>
        </div>
      </header>
    </>
  )
}
{
  tool && (
    <>
      <i class="at-stuck-probe" aria-hidden="true" />
      <header class="at-site-header" data-tool="">
        <a class="at-logo at-wordmark" href={home} aria-label={t('header.home')}>
          <Mark size={26} />
          <span class="at-logo-word">{t('app.name')}</span>
        </a>
        <div class="at-header-end">
          <slot />
          <div class="at-hm-panel at-hm-menu" id="at-hm-menu" popover style="position-anchor:--at-hm-menu">
            <div class="at-hm-head">
              <p class="at-hm-title">{t('header.menu')}</p>
              <button class="at-icon-button" type="button" popovertarget="at-hm-menu" popovertargetaction="hide" aria-label={t('header.menu.close')}>
                <Lucide name="x" size={20} />
              </button>
            </div>
            <nav class="at-hm-body" aria-label={t('header.nav')}>
              <HeaderMenuGroup locale={locale} kind="for" scope="menu" path={path} />
              <HeaderMenuGroup locale={locale} kind="on" scope="menu" path={path} />
              <HeaderMenuGroup locale={locale} kind="res" scope="menu" path={path} />
              <ul class="at-hm-links" role="list">
                {links.map(([id, href, label]) => (
                  <li>
                    <a class="at-hm-link" href={href} hreflang={english ? 'en' : undefined} aria-current={id === first ? 'page' : undefined}>
                      {label}
                      {english && <span class="sr-only"> {t('header.nav.english')}</span>}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
            <div class="at-hm-cta">
              <HeaderAdd locale={locale} />
            </div>
          </div>
        </div>
      </header>
    </>
  )
}
