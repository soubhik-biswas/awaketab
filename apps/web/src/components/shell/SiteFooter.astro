---
import { createT } from '../../i18n/load';
import { localePath, type TLocale } from '../../i18n/locales';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../../lib/contact';
import { VERSION } from '../../lib/version';
import Mark from '../brand/Mark.astro';
import Lucide from '../icons/Lucide.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeSwitch from './ThemeSwitch.astro';
import footerCss from '../../styles/footer.css?url';

interface Props {
  locale: TLocale;
  links?: Partial<Record<TLocale, string>> | undefined;
}

interface ILink {
  href: string;
  label: string;
  external?: boolean;
  keys?: boolean;
}

const { locale, links } = Astro.props;
const t = createT(locale);
const home = localePath(locale, '/');
const trim = (path: string): string => path.replace(/(.)\/$/u, '$1');
const here = trim(Astro.url.pathname);
const english = locale !== 'en';
const repo = 'https://github.com/SoubhikBiswas-gitHub/awaketab';
const year = /^\d{4}/u.exec(VERSION)?.[0] ?? String(new Date().getFullYear());

// The board's four links lead each column; the product pages the site already had follow them.
const columns: Array<{ title: string; items: ILink[] }> = [
  {
    title: t('site.foot.product'),
    items: [
      { href: home, label: t('site.foot.timer') },
      { href: '/pro', label: t('header.nav.pro') },
      { href: '/changelog', label: t('site.foot.changelog') },
      { href: '/signin', label: t('site.signin') },
      { href: '/extension', label: t('header.nav.extension') },
      { href: '/embed', label: t('footer.embed') },
      { href: '/kiosk', label: t('footer.kiosk') },
      { href: '/library', label: t('footer.library') },
    ],
  },
  {
    title: t('site.foot.learn'),
    items: [
      { href: '/help', label: t('site.foot.help') },
      { href: '/for', label: t('site.nav.uses') },
      { href: '/for/presentations', label: t('site.foot.presenting') },
      { href: '/learn/browser-support-matrix', label: t('site.nav.support') },
      { href: '/on', label: t('footer.on.all') },
      { href: '/guides', label: t('footer.guides') },
      { href: '/vs', label: t('footer.compare') },
      { href: '/learn', label: t('footer.docs') },
    ],
  },
  {
    title: t('site.foot.company'),
    items: [
      { href: '/about', label: t('site.foot.about') },
      { href: '/privacy', label: t('footer.privacy') },
      { href: '/terms', label: t('footer.terms') },
      { href: '/status', label: t('site.foot.status') },
      { href: `${home}#keys`, label: t('footer.shortcuts'), keys: true },
      { href: repo, label: t('footer.source'), external: true },
      { href: 'https://buymeacoffee.com/awaketab', label: t('footer.donate'), external: true },
    ],
  },
];
---

<footer class="at-foot" data-theme="dark">
  <link rel="stylesheet" href={footerCss} />
  <div class="at-foot-in">
    <div class="at-foot-grid">
      <div class="at-foot-brand">
        <a class="at-foot-logo" href={home} aria-label={t('header.home')}>
          <Mark size={28} small />
          <strong>{t('app.name')}</strong>
        </a>
        <p class="at-foot-tag">{t('site.foot.tagline')}</p>
      </div>
      <nav class="at-foot-nav" aria-label={t('footer.nav')}>
        {
          columns.map((col, ci) => (
            <div class="at-foot-col">
              <h2 class="at-foot-h" id={`at-foot-h-${String(ci)}`}>
                {col.title}
              </h2>
              <ul role="list" aria-labelledby={`at-foot-h-${String(ci)}`}>
                {col.items.map((item) => {
                  const enOnly = english && !item.external && item.href.startsWith('/') && item.href !== home;
                  return (
                    <li>
                      <a
                        href={item.href}
                        rel={item.external ? 'noopener' : undefined}
                        target={item.external ? '_blank' : undefined}
                        hreflang={enOnly && !item.keys ? 'en' : undefined}
                        data-keys={item.keys ? '' : undefined}
                        aria-current={!item.external && !item.keys && trim(item.href) === here ? 'page' : undefined}
                      >
                        {item.label}
                        {item.external && <Lucide name="arrow-up-right" size={16} />}
                        {enOnly && !item.keys && <span class="sr-only"> {t('header.nav.english')}</span>}
                      </a>
                    </li>
                  );
                })}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>
    <div class="at-foot-base">
      <p class="at-foot-legal">
        <span>{t('footer.copyright', { year })}</span>
        <span aria-hidden="true">·</span>
        <span>
          {t('site.foot.contact')} <a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a>
        </span>
      </p>
      <p class="at-foot-legal">
        <span data-version>{t('footer.version', { version: VERSION })}</span>
        <span aria-hidden="true">·</span>
        <span>{t('site.foot.cookies')}</span>
      </p>
    </div>
    <div class="at-foot-acts">
      <ThemeSwitch locale={locale} />
      <LangSwitch locale={locale} links={links} />
      <a class="at-foot-top" href="#content" data-top>
        <Lucide name="arrow-up" size={16} />
        {t('footer.top')}
      </a>
    </div>
  </div>
</footer>
