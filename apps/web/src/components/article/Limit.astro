---
import Lucide from '../icons/Lucide.astro';

interface Props {
  text: string;
  label: string;
  inline?: boolean;
}
const { text, label, inline = false } = Astro.props;
---

<aside
  id={inline ? undefined : 's-limit'}
  class="at-sp-callout at-limit-note"
  data-tone="info"
  aria-labelledby={inline ? 'h-limit-in' : 'h-limit'}
>
  <Lucide name="info" size={20} />
  <span class="at-sp-callout-text">
    <h2 id={inline ? 'h-limit-in' : 'h-limit'} class="at-sp-callout-t">{label}</h2>
    <span class="at-sp-body">{text}</span>
  </span>
</aside>
