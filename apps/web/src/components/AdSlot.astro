---
import { createT } from '../i18n/load';
import { localeFromPath } from '../i18n/locales';

// One slot per content page, below the tool, never beside a button and never animated (docs/00 §8.3, docs/09 §3.1).
// The box keeps a fixed size from first paint so CLS stays 0; lib/ads.ts and the placement check read data-ad-slot.
const t = createT(localeFromPath(Astro.url.pathname));
---

<aside class="at-sp-ad at-ad" aria-label={t('content.ad')}>
  <span class="at-sp-eyebrow" aria-hidden="true">{t('content.ad')}</span>
  <div class="at-ad-box" data-ad-slot="inline" data-size-sm="300x250" data-size="336x280"></div>
</aside>
