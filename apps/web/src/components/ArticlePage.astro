---
import type { CollectionEntry } from 'astro:content';
import ContentLayout from '../layouts/ContentLayout.astro';
import ToolIsland from './ToolIsland.astro';
import Button from './shell/Button.astro';
import AdSlot from './AdSlot.astro';
import Limit from './article/Limit.astro';
import Lucide from './icons/Lucide.astro';
import Brand from './icons/Brand.astro';
import ArticleParts from './article/ArticleParts.astro';
import PageHero from './site/PageHero.astro';
import ToolCard from './site/ToolCard.astro';
import Faq from './site/Faq.astro';
import Cards from './site/Cards.astro';
import { shouldRenderAdSlots } from '../lib/ads';
import { useCaseScene, type TSceneKey } from '../lib/scenes';
import { fullDate as formatFullDate } from '../lib/full-date';
import { createT, t as tEn } from '../i18n/load';
import '../styles/tool-embed.css';
import { LOCALE_META } from '../i18n/locales';
import { articleSchema } from '../lib/seo';
import {
  inline,
  placedBlocks,
  splitArticle,
  type TArticlePart,
  type TBlockName,
} from '../lib/article';
import { articleCss, minifyCss } from '../lib/article-css';
import tableSheet from '../styles/article/table.css?raw';
import { HUBS } from '../lib/hubs';
import { readingMinutes } from '../lib/docs-hub';
import { deviceLogos, rowBrands } from '../lib/brands';
import {
  contentIndex,
  pageAlternates,
  pageIndexable,
  pageOgImage,
  pagePath,
  pageTranslations,
  splitEntryId,
  type TContentKind,
} from '../lib/content-i18n';

interface Props {
  kind: TContentKind;
  entry: CollectionEntry<TContentKind>;
}

const PRESET_HREF = {
  p15: '/15m',
  p30: '/30m',
  p45: '/45m',
  p60: '/1h',
  p120: '/2h',
  p240: '/4h',
  pinf: '/',
  custom: '/8h',
  until: '/',
} as const;
// docs/06 §10: the down-link names the duration it starts ("Start a 30-minute session"); English only.
const PRESET_WORDS: Partial<Record<keyof typeof PRESET_HREF, string>> = {
  p15: '15-minute',
  p30: '30-minute',
  p45: '45-minute',
  p60: '1-hour',
  p120: '2-hour',
  p240: '4-hour',
};

const { kind, entry } = Astro.props;
const data = entry.data;
const site =
  Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const { locale, enSlug } = splitEntryId(entry.id);
const english = locale === 'en';
const t = createT(locale);
const meta = LOCALE_META[locale];
const index = await contentIndex();
const path = pagePath(kind, enSlug, locale);
const canonical = `${site}${path}`;
// Unreviewed translations are `noindex` and carry no hreflang until a native reviewer sets
// `reviewed: true` — the same rule the locale homes follow (docs/07 §2, §5).
const indexable = pageIndexable({ locale, reviewed: data.reviewed, noindex: data.noindex });
const alternates = indexable ? pageAlternates(index, kind, enSlug, locale, site) : undefined;
const translations = pageTranslations(index, kind, enSlug);
const hubCrumb = HUBS[kind].crumb;
// Locale homes are the one page URL with a trailing slash, `/es/` (`es/index.html`, docs/14 §2.1).
const homeHref = english ? '/' : `/${locale}/`;
const published = data.published.toISOString().slice(0, 10);
const fullDate = (date: Date): string => formatFullDate(date, english ? 'en' : meta.htmlLang);
const verified = data.lastVerified ? fullDate(data.lastVerified) : null;
const updated = verified ? null : fullDate(data.updated ?? data.published);
const minutes = readingMinutes(entry.body, data);
const stale =
  data.lastVerified !== undefined && Date.now() - data.lastVerified.getTime() > 180 * 86_400_000;
// Locale pages start the session on the locale home (the tool routes are not duplicated per locale),
// carrying the scenario preset and mode as the documented query params (docs/00 §7).
const startHref = english
  ? PRESET_HREF[data.preset]
  : `${homeHref}?preset=${data.preset}${data.mode === 'standard' ? '' : `&mode=${data.mode}`}`;
const startWords = english ? PRESET_WORDS[data.preset] : undefined;
const startLabel = startWords
  ? `Start a ${startWords} session`
  : t('content.start');
const ogImage = english
  ? `/og/${kind}-en.png`
  : pageOgImage(kind, enSlug, locale);
const crumbLabel = data.crumb ?? data.h1;
const breadcrumbs = english
  ? [
      { name: 'AwakeTab', url: site },
      { name: hubCrumb, url: `${site}/${kind}` },
      { name: crumbLabel, url: canonical },
    ]
  : [
      { name: 'AwakeTab', url: `${site}${homeHref}` },
      { name: crumbLabel, url: canonical },
    ];
const crumbs: Array<{ href?: string | undefined; label: string }> = [
  { href: homeHref, label: t('app.name') },
  ...(english ? [{ href: `/${kind}`, label: hubCrumb }] : []),
  { label: crumbLabel },
];

// Related links: English pages use the target's h1 as anchor text (docs/06 §10); translations link the
// same-locale page when it exists, otherwise the English page, marked as English.
interface IRelatedLink {
  href: string;
  label: string;
  lang?: string;
}
// Site pages outside the collections (English only) that `related` may name, with the h1 of each as anchor text.
const SITE_PAGES: Record<string, string> = {
  '/embed': tEn('page.embed.h1'),
  '/extension': tEn('page.extension.h1'),
  '/kiosk': tEn('page.kiosk.h1'),
  '/library': tEn('page.library.h1'),
  '/pro': tEn('page.pro.h1'),
  '/about': tEn('page.about.h1'),
};
const related: IRelatedLink[] = data.related.map((href) => {
  const [, targetKind = '', targetSlug = ''] = href.split('/');
  const source = index.find((page) => page.kind === targetKind && page.enSlug === targetSlug && page.locale === 'en');
  const fallback = SITE_PAGES[href] ?? href.replace(/^\//u, '').replaceAll('/', ' · ').replaceAll('-', ' ');
  if (english) return { href, label: source?.h1 ?? fallback };
  const sameLocale = index.find(
    (page) => page.kind === targetKind && page.enSlug === targetSlug && page.locale === locale,
  );
  if (sameLocale) return { href: pagePath(sameLocale.kind, targetSlug, locale), label: sameLocale.h1 };
  return { href, label: `${source?.h1 ?? fallback} (${LOCALE_META.en.label})`, lang: 'en' };
});
const englishHref = translations.en;

// One template for every family (docs/06 §24): head, contents, body, honest limit, tool, questions, related, author.
const family = t(`content.family.${kind}`);
const toolCopy = kind === 'guides' ? 'skip' : 'try';
// Use cases and device guides put the tool right after the head: people land there to start it.
const toolFirst = kind === 'for' || kind === 'on';
const relatedTitle = kind === 'for' ? t('content.related.for') : t('content.related');
// Device pages show the system and browser they are about beside the family label, as their hub card does.
const headLogos = kind === 'on' ? deviceLogos(enSlug, data.browsers, data.os) : [];

// Body: the rendered Markdown cut into sections (lib/article.ts). The one ad slot sits below the tool now, so an
// `::ad` marker in the body only splits the list.
const parts: TArticlePart[] = splitArticle(entry.rendered?.html ?? '').filter((part) => part.kind !== 'ad');
const showAds = shouldRenderAdSlots();

const stepVariant = data.steps?.some((st) => st.shot)
  ? 'shots'
  : kind === 'guides'
    ? 'track'
    : 'card';
const tracked = stepVariant === 'track' && (data.steps?.length ?? 0) > 0;
const blockCss = articleCss(
  placedBlocks(parts).map((b) => b.split(' ')[0] as TBlockName),
  data.steps ? stepVariant : null,
);
// Markdown tables (lib/article.ts) bring their own sheet, so pages without one do not pay for it.
const tableCss = parts.some(
  (part) => part.kind === 'section' && part.parts.some((p) => p.kind === 'html' && p.html.includes('class="at-table"')),
)
  ? minifyCss(tableSheet)
  : '';

// "On this page": the page's own sections and the template's blocks, in page order.
const toolEntry = { href: '#s-tool', label: data.toc?.['s-tool'] ?? t(`content.${toolCopy}.title`) };
const toc: Array<{ href: string; label: string }> = [
  ...(toolFirst ? [toolEntry] : []),
  ...parts.flatMap((part) =>
    part.kind === 'section' && part.id && part.title
      ? [{ href: `#${part.id}`, label: data.toc?.[part.id] ?? part.title }]
      : [],
  ),
  { href: '#s-limit', label: t('content.limit') },
  ...(toolFirst ? [] : [toolEntry]),
  { href: '#faq', label: t('content.faq') },
  ...(related.length > 0 ? [{ href: '#s-related', label: relatedTitle }] : []),
];
const author = 'Soubhik Biswas';
const toolLine = data.toolNote ?? t(`content.${toolCopy}.body`);
// Hero art as on the content boards: the use case's own scene, the first-action scene on device guides, the
// maintenance scene on fixes; comparisons and docs carry none.
const scene: TSceneKey | undefined =
  kind === 'for' ? useCaseScene(enSlug) : kind === 'on' ? 'firstaction' : kind === 'guides' ? 'maintenance' : undefined;
const heroAction =
  kind === 'on'
    ? { href: homeHref, label: t('site.article.open') }
    : kind === 'guides'
      ? { href: startHref, label: startLabel }
      : null;
const relatedCards = related.map((link) => ({
  href: link.href,
  title: link.label,
  link: t('site.article.read'),
  lang: link.lang,
}));
const faqItems = data.faq.map((item) => ({ q: item.q, html: `<p>${inline(item.a)}</p>` }));
---

<ContentLayout
  title={data.title}
  description={data.description}
  canonical={canonical}
  locale={locale}
  noindex={!indexable}
  ogImage={ogImage}
  ogImageAlt={data.h1}
  alternates={alternates}
  localeLinks={translations}
  family={kind}
  schema={articleSchema({
    canonical,
    title: data.h1,
    description: data.description,
    locale,
    published,
    image: `${site}${ogImage}`,
    ...(data.updated ? { updated: data.updated.toISOString().slice(0, 10) } : {}),
    breadcrumbs,
  })}
>
  {blockCss && <style is:inline slot="styles" set:html={blockCss} />}
  {tableCss && <style is:inline slot="styles" set:html={tableCss} />}

  <PageHero
    crumbs={crumbs}
    crumbLabel={english ? 'Breadcrumb' : t('content.breadcrumb')}
    h1={data.h1}
    leadHtml={data.lead ? inline(data.lead) : undefined}
    scene={scene}
  >
    <p class="at-family" slot="kicker">
      {headLogos.map((logo) => <Brand logo={logo} size={24} />)}
      <span class="at-sp-eyebrow">{family}</span>
    </p>
    <div class="at-meta" slot="meta">
      {
        verified && (
          <span class="at-meta-verified">
            <Lucide name="badge-check" size={16} />
            {t('content.verified', { date: verified })}
          </span>
        )
      }
      {
        updated && (
          <span class="at-meta-verified">
            <Lucide name="calendar-check" size={16} />
            {t('content.updated', { date: updated })}
          </span>
        )
      }
      {
        minutes !== null && (
          <span class="at-meta-read">
            <Lucide name="clock" size={16} />
            {t('content.readTime', { n: minutes })}
          </span>
        )
      }
      <span class="at-meta-by">{t('content.byline', { name: author })}</span>
      {
        stale && (
          <span class="at-meta-stale">
            <Lucide name="rotate-ccw" size={16} />
            {t('content.stale')}
          </span>
        )
      }
      {
        !english && !data.reviewed && (
          <p class="at-meta-pending" role="note" data-translation-pending>
            <Lucide name="languages" size={16} />
            <span>
              {t('content.translation.pending')}{' '}
              {englishHref && (
                <a href={englishHref} hreflang="en">
                  {t('content.translation.original')}
                </a>
              )}
            </span>
          </p>
        )
      }
    </div>
    {
      heroAction && (
        <Button slot="actions" variant="primary" size="xl" icon="play" href={heroAction.href}>
          {heroAction.label}
        </Button>
      )
    }
    {
      data.facts && (
        <ul class="at-facts">
          {data.facts.map((fact) => (
            <li>
              {rowBrands(fact.label).map((logo) => (
                <Brand logo={logo} />
              ))}
              <span>{fact.label}</span>
              <strong>{fact.value}</strong>
            </li>
          ))}
        </ul>
      )
    }
    {
      tracked && data.steps ? (
        <nav class="at-toc at-toc-steps" aria-label={t('content.stepsNav')} data-progress>
          <span class="at-toc-k">
            <span class="at-sp-small">{t('content.progress')}</span>
            <span class="at-progress" aria-hidden="true">
              <span data-bar />
            </span>
            <span
              class="at-prog at-sp-small"
              aria-live="polite"
              data-prog
              data-count={t('content.progressCount', { n: '{n}', total: '{total}' })}
              data-next={t('content.progressNext', { n: '{n}', total: '{total}', next: '{next}' })}
              data-all={t('content.progressAll', { total: '{total}' })}
            >
              {t('content.progressNext', { n: 0, total: data.steps.length, next: 1 })}
            </span>
          </span>
          <ol class="at-sp-chips" role="list">
            {data.steps.map((step, i) => (
              <li>
                <a class="at-sp-chip" href={`#step-${String(i + 1)}`} aria-current={i === 0 ? 'step' : undefined}>
                  <span class="at-step-n" aria-hidden="true">
                    <span>{i + 1}</span>
                    <Lucide name="check" size={16} />
                  </span>
                  <span>{step.short ?? step.title}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      ) : (
        <nav class="at-toc" aria-label={t('content.toc')} data-spy>
          <span class="at-sp-small at-toc-k">{t('content.toc')}</span>
          <ul class="at-sp-chips" role="list">
            {toc.map((item, i) => (
              <li>
                <a class="at-sp-chip" href={item.href} aria-current={i === 0 ? 'location' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </PageHero>

  {
    toolFirst && (
      <ToolCard
        eyebrow={t('site.tool.eyebrow')}
        title={t(`content.${toolCopy}.title`)}
        descHtml={inline(toolLine)}
        href={startHref}
        label={startLabel}
      >
        <ToolIsland embed heading={data.h1} autostart="0" preset={data.preset} mode={data.mode} locale={locale} />
      </ToolCard>
    )
  }
  {toolFirst && showAds && <div class="at-sp-block"><AdSlot /></div>}

  <div class="at-body">
    <ArticleParts list={parts} data={data} t={t} id={entry.id} kind={kind} />
    <slot name="after" />
    <div class="at-sp-block">
      <Limit text={data.honestLimit} label={t('content.limit')} />
    </div>
  </div>

  {
    !toolFirst && (
      <ToolCard
        eyebrow={t('site.tool.eyebrow')}
        title={t(`content.${toolCopy}.title`)}
        descHtml={inline(toolLine)}
        href={startHref}
        label={startLabel}
      >
        <ToolIsland embed heading={data.h1} autostart="0" preset={data.preset} mode={data.mode} locale={locale} />
      </ToolCard>
    )
  }
  {!toolFirst && showAds && <div class="at-sp-block"><AdSlot /></div>}

  <section class="at-faq-sec at-sp-block" aria-labelledby="faq">
    <h2 id="faq" class="at-sp-h2">{t('content.faq')}</h2>
    <Faq items={faqItems} openFirst />
  </section>

  {
    related.length > 0 && (
      <section id="s-related" class="at-sp-block" aria-labelledby="h-related">
        <h2 id="h-related" class="at-sp-h2">{relatedTitle}</h2>
        <Cards items={relatedCards} cols={2} />
      </section>
    )
  }

  <div class="at-author">
    <span class="at-avatar" aria-hidden="true">SB</span>
    <p class="at-sp-small">
      <strong class="at-author-name">{author}</strong>
      {t('content.author.role')}
      {verified && <>{t('content.verified', { date: verified })}.</>}
      <a href="/about">{t('content.author.about')}</a>
    </p>
  </div>
</ContentLayout>
