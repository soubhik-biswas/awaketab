---
import HomeExtension from './home/HomeExtension.astro';
import HomeLevels from './home/HomeLevels.astro';
import HomeYours from './home/HomeYours.astro';
import Block from './site/Block.astro';
import Cards, { type ICard } from './site/Cards.astro';
import Steps from './site/Steps.astro';
import Callout from './site/Callout.astro';
import Faq from './site/Faq.astro';
import Cta from './site/Cta.astro';
import Lucide from './icons/Lucide.astro';
import homeCss from '../styles/home.css?url';
import siteCss from '../styles/site.css?url';
import sceneCss from '../styles/scene.css?url';
import { createT } from '../i18n/load';
import type { TLocale } from '../i18n/locales';
import { contentIndex, pagePath } from '../lib/content-i18n';
import type { TSceneKey } from '../lib/scenes';

interface Props {
  locale?: TLocale;
}
const { locale = 'en' } = Astro.props;
const t = createT(locale);
const english = locale === 'en';

// The home board's four moments, each linked to its use-case guide (the same-language page when one exists).
const USES: ReadonlyArray<readonly [slug: string, key: string, scene: TSceneKey]> = [
  ['cooking', 'cooking', 'cooking'],
  ['presentations', 'presenting', 'presenting'],
  ['dashboards', 'dashboards', 'dashboard'],
  ['reading', 'nightdesk', 'nightdesk'],
];
const index = await contentIndex();
const cards: ICard[] = USES.map(([slug, key, scene]) => {
  const translated = !english && index.some((p) => p.kind === 'for' && p.enSlug === slug && p.locale === locale);
  return {
    href: translated ? pagePath('for', slug, locale) : `/for/${slug}`,
    lang: english || translated ? undefined : 'en',
    title: t(`site.home.uses.${key}`),
    desc: t(`site.home.uses.${key}.body`),
    scene,
    link: t(`site.home.uses.${key}.link`),
  };
});
const useCaseCount = index.filter((page) => page.kind === 'for' && page.locale === 'en').length;
const steps = [1, 2, 3].map((n) => ({ title: t(`site.home.how.${String(n)}`), body: t(`site.home.how.${String(n)}.body`) }));
const faq = [1, 2, 3, 4].map((n) => ({ q: t(`site.home.faq.${String(n)}`), a: t(`site.home.faq.${String(n)}.a`) }));
---

<div class="at-hb">
  <link rel="stylesheet" href={siteCss} />
  <link rel="stylesheet" href={sceneCss} />
  <link rel="stylesheet" href={homeCss} />

  <Block id="home-uses" h={t('site.home.uses.title')}>
    <Cards items={cards} cols={4} />
    <a class="at-hb-more" href="/for" hreflang={english ? undefined : 'en'}>
      <span>{t('page.home.uses.all', { count: useCaseCount })}</span>
      <Lucide name="arrow-right" size={20} class="at-hb-arrow" />
    </a>
  </Block>

  <Block id="home-how" h={t('page.home.how.title')}>
    <Steps items={steps} />
  </Block>

  <Block label={t('site.home.limits.title')}>
    <Callout tone="info" title={t('site.home.limits.title')} body={t('site.home.limits.body')} />
  </Block>

  <HomeYours locale={locale} />

  <HomeExtension locale={locale} />

  <HomeLevels locale={locale} />

  <section id="home-faq" class="at-sp-block" aria-labelledby="home-faq-h">
    <h2 id="home-faq-h" class="at-sp-h2">{t('content.faq')}</h2>
    <Faq items={faq} />
  </section>

  <Block label={t('site.cta.label')}>
    <Cta
      title={t('site.cta.title')}
      desc={t('site.cta.desc')}
      href="#content"
      label={t('site.home.cta')}
    />
  </Block>
</div>
