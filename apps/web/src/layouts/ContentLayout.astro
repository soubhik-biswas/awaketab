---
import BaseLayout from './BaseLayout.astro';
import '../styles/content.css';
import type { TLocale } from '../i18n/locales';
import type { TSchemaNode } from '../lib/seo';
import { shouldRenderAdSlots } from '../lib/ads';
import { minifyCss } from '../lib/article-css';
import adSheet from '../styles/article/ads.css?raw';

interface Props {
  title: string;
  description: string;
  canonical: string;
  locale?: TLocale;
  noindex?: boolean;
  ogImage?: string | undefined;
  ogImageAlt?: string | undefined;
  schema: TSchemaNode;
  alternates?: Array<{ locale: TLocale; href: string }> | undefined;
  localeLinks?: Partial<Record<TLocale, string>> | undefined;
  family: string;
}

const {
  title,
  description,
  canonical,
  locale = 'en',
  noindex = false,
  ogImage,
  ogImageAlt,
  schema,
  alternates,
  localeLinks,
  family,
} = Astro.props;
// The page itself places its one AdSlot below the tool; the sheet ships only when ads can render.
const showAds = shouldRenderAdSlots();
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  locale={locale}
  noindex={noindex}
  ogImage={ogImage}
  ogImageAlt={ogImageAlt}
  schema={schema}
  alternates={alternates}
  localeLinks={localeLinks}
  contentPage
  site
>
  <slot name="styles" slot="head" />
  {showAds && <style is:inline slot="head" set:html={minifyCss(adSheet)} />}
  <main class="at-cp">
    <article class="at-sp at-art" data-family={family}>
      <slot />
    </article>
  </main>
  <script>
    import { initContentNav } from '../lib/content-nav';
    import { bootAds } from '../lib/ads';
    import { telemetryOn } from '../lib/pro-common';

    initContentNav();
    void bootAds({
      onSlot: (page) => {
        if (!telemetryOn()) return;
        void import('../lib/analytics.js').then((mod) => {
          mod.track('ad_slot_loaded', { page }, { telemetry: true, source: 'web', locale: document.documentElement.lang || 'en' });
        });
      },
    });
  </script>
</BaseLayout>
