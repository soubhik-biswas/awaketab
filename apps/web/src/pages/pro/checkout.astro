---
// The Pro purchase flow before payment: plan → account → inbox → pay. Payment happens on Polar, which returns to
// /pro/activate for processing, success or declined. lib/checkout-page.ts switches `data-step`.
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lucide from '../../components/icons/Lucide.astro';
import ProFlowHeader from '../../components/pro/ProFlowHeader.astro';
import ProScene from '../../components/pro/ProScene.astro';
import { t } from '../../i18n/load';
import { CHECKOUT_LINKS, PAYMENTS_ENABLED } from '../../lib/checkout';
import { PLAN_PRICES, PRO_LAUNCH_END } from '../../lib/license';
import { SIGNIN_MINUTES } from '../../lib/account';
import { usd } from '../../lib/pro-common';
import '../../styles/pro.css';

const c = (key: string, vars?: Record<string, string | number>) => t(`proflow.checkout.${key}`, vars);
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const launch = Date.now() < PRO_LAUNCH_END;
const yearly = usd(PLAN_PRICES.pro_yearly);
const lifeLaunch = usd(PLAN_PRICES.pro_lifetime_launch);
const lifeFull = usd(PLAN_PRICES.pro_lifetime);
const free = [1, 2, 3, 4].map((n) => c(`free.f${n}`));
const pro = [1, 2, 3, 4, 5, 6].map((n) => c(`pro.f${n}`));
---

<BaseLayout title={c('title')} description={c('description')} canonical={`${site}/pro/checkout`} noindex bare>
  <div
    class="at-pro at-pro-flow"
    data-checkout-root
    data-step="plans"
    data-plan="pro_yearly"
    data-launch={launch ? 'on' : 'off'}
    data-launch-end={String(PRO_LAUNCH_END)}
    data-link-pro_yearly={CHECKOUT_LINKS.pro_yearly}
    data-link-pro_lifetime={CHECKOUT_LINKS.pro_lifetime}
  >
    <div class="at-pro-flow-glow at-pro-flow-glow-a" aria-hidden="true"></div>
    <div class="at-pro-flow-glow at-pro-flow-glow-b" aria-hidden="true"></div>
    <ProFlowHeader step={0} />

    <main class="at-pro-flow-plans at-pro-rise" data-for="plans" aria-labelledby="co-plans-h">
      <p class="at-pro-flow-kicker">{c('kicker')}</p>
      <h1 id="co-plans-h" class="at-pro-flow-display" tabindex="-1">{c('plans.h1')}</h1>
      <p class="at-pro-flow-intro">{c('plans.lead')}</p>
      <div class="at-pro-seg at-pro-seg-lg" role="radiogroup" aria-label={c('plans.period')}>
        <button type="button" class="at-pro-seg-btn" role="radio" aria-checked="true" data-pick="pro_yearly">{c('plans.yearly')}</button>
        <button type="button" class="at-pro-seg-btn" role="radio" aria-checked="false" data-pick="pro_lifetime">{c('plans.lifetime')}</button>
      </div>
      <div class="at-pro-flow-cards">
        <div class="at-pro-plan">
          <strong class="at-pro-flow-plan-name">{c('free.name')}</strong>
          <span class="at-pro-flow-price">{c('free.price')}</span>
          <ul class="at-pro-feats">
            {free.map((f) => <li><Lucide name="check" size={18} class="at-pro-feat-icon" />{f}</li>)}
          </ul>
          <span class="at-pro-flow-on-free">{c('free.now')}</span>
        </div>
        <div class="at-pro-plan at-pro-plan-pro">
          <span class="at-pro-plan-top">
            <strong class="at-pro-flow-plan-name">{c('pro.name')}</strong>
            <span class="at-pro-chip at-pro-chip-lg" data-for-plan="pro_yearly">{c('pro.badge.yearly')}</span>
            <span class="at-pro-chip at-pro-chip-lg" data-for-plan="pro_lifetime">{c('pro.badge.lifetime')}</span>
          </span>
          <span class="at-pro-flow-price">
            <span data-for-plan="pro_yearly">{c('price.yearly', { price: yearly })}</span>
            <span data-for-plan="pro_lifetime"><span data-launch-only>{c('price.lifetime', { price: lifeLaunch })}</span><span data-after-only>{c('price.lifetime', { price: lifeFull })}</span></span>
          </span>
          <ul class="at-pro-feats">
            {pro.map((f) => <li><Lucide name="check" size={18} class="at-pro-feat-icon" />{f}</li>)}
          </ul>
          <button type="button" class="at-button at-button-primary at-button-lg at-pro-btn-glow" data-go="account" disabled={!PAYMENTS_ENABLED}>
            {c('plans.continue')}<Lucide name="arrow-right" size={18} class="at-flip-rtl" />
          </button>
          {!PAYMENTS_ENABLED && <span class="at-pro-help-txt" role="status">{c('soon')}</span>}
        </div>
      </div>
    </main>

    <main class="at-pro-flow-col at-pro-rise" data-for="account" hidden aria-labelledby="co-account-h">
      <h1 id="co-account-h" class="at-pro-flow-h1" tabindex="-1">{c('account.h1')}</h1>
      <p class="at-pro-flow-lead">{c('account.lead')}</p>
      <form class="at-pro-flow-form" data-account-form novalidate>
        <label class="at-pro-flow-label">
          <span class="at-pro-flow-label-text">{c('account.label')}</span>
          <input class="at-pro-input at-pro-input-flow" type="email" name="email" placeholder="you@example.com" autocomplete="email" inputmode="email" spellcheck="false" maxlength="254" aria-describedby="co-email-hint" data-account-email />
        </label>
        <span id="co-email-hint" class="at-pro-flow-hint" aria-live="polite" data-account-hint data-ok={c('account.ok')} data-idle={c('account.idle')} data-offline={c('account.offline')}>{c('account.idle')}</span>
        <button type="submit" class="at-button at-button-primary at-button-lg at-pro-btn-wide" aria-disabled="true" data-account-send>
          <span data-label-idle>{c('account.send')}</span><span data-label-busy>{c('account.sending')}</span>
        </button>
      </form>
      <button type="button" class="at-pro-link-btn" data-go="plans">{c('back.plans')}</button>
    </main>

    <main class="at-pro-flow-col at-pro-rise" data-for="check" hidden aria-labelledby="co-check-h">
      <ProScene scene="firstaction" width={260} />
      <h1 id="co-check-h" class="at-pro-flow-h1" tabindex="-1">{c('check.h1')}</h1>
      <p class="at-pro-flow-lead">{c('check.before')} <strong data-email-out></strong>{c('check.after', { minutes: SIGNIN_MINUTES })}</p>
      <button type="button" class="at-button at-button-primary at-button-lg at-pro-btn-glow" data-go="pay">{c('check.continue')}</button>
      <button type="button" class="at-pro-link-btn" data-go="account">{c('check.other')}</button>
    </main>

    <main class="at-pro-flow-col at-pro-rise" data-for="pay" hidden aria-labelledby="co-pay-h">
      <h1 id="co-pay-h" class="at-pro-flow-h1" tabindex="-1">{c('pay.h1')}</h1>
      <div class="at-pro-flow-note" role="note" data-unsent hidden>
        <Lucide name="info" size={18} />
        <span>{c('pay.unsent')}</span>
      </div>
      <dl class="at-pro-summary">
        <div class="at-pro-summary-row"><dt>{c('pay.plan')}</dt><dd>{c('pay.plan.v')}</dd></div>
        <div class="at-pro-summary-row">
          <dt>{c('pay.billing')}</dt>
          <dd><span data-for-plan="pro_yearly" data-renews data-tpl={c('pay.billing.yearly')}></span><span data-for-plan="pro_lifetime">{c('pay.billing.lifetime')}</span></dd>
        </div>
        <div class="at-pro-summary-row"><dt>{c('pay.account')}</dt><dd data-email-out></dd></div>
        <div class="at-pro-summary-row at-pro-summary-total">
          <dt>{c('pay.total')}</dt>
          <dd><span data-for-plan="pro_yearly">{yearly}</span><span data-for-plan="pro_lifetime"><span data-launch-only>{lifeLaunch}</span><span data-after-only>{lifeFull}</span></span></dd>
        </div>
      </dl>
      <button type="button" class="at-button at-button-primary at-button-lg at-pro-btn-glow" data-pay disabled={!PAYMENTS_ENABLED}>
        <Lucide name="lock" size={18} />{c('pay.btn')}
      </button>
      <span class="at-pro-flow-small">
        {c('pay.note')} <span data-for-plan="pro_yearly">{c('pay.note.cancel')}</span>
      </span>
      <button type="button" class="at-pro-link-btn" data-go="plans">{c('back.plans')}</button>
    </main>
  </div>
  <script>
    import { bootCheckoutPage } from '../../lib/checkout-page';
    const root = document.querySelector<HTMLElement>('[data-checkout-root]');
    if (root) bootCheckoutPage(root);
  </script>
</BaseLayout>
