---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Block from '../components/site/Block.astro';
import Cards from '../components/site/Cards.astro';
import Callout from '../components/site/Callout.astro';
import Lucide from '../components/icons/Lucide.astro';
import { t } from '../i18n/load';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../lib/contact';
import { CONTENT_KINDS } from '../lib/content-i18n';
import { buildDate, fullDate } from '../lib/full-date';
import { HELP_CHIPS, HELP_TOPICS } from '../lib/help-topics';
import type { IHelpEntry } from '../lib/help-search';
import { articleSchema } from '../lib/seo';
import { VERSION } from '../lib/version';

const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const canonical = `${site}/help`;
const title = t('site.help.title');
const description = t('site.help.description');
const h1 = t('site.help.h1');
const built = buildDate(VERSION);
const idle = built
  ? t('site.help.count', { n: HELP_TOPICS.length, date: fullDate(built) })
  : t('site.help.countPlain', { n: HELP_TOPICS.length });

// The search reads the board topics first, then every English article by its title and description.
const index: IHelpEntry[] = HELP_TOPICS.map((topic) => ({ title: topic.title, href: topic.href, words: `${topic.line} ${topic.words}` }));
for (const kind of CONTENT_KINDS) {
  for (const entry of await getCollection(kind)) {
    if (entry.data.locale !== 'en' || entry.data.noindex) continue;
    index.push({ title: entry.data.h1, href: `/${kind}/${entry.id.replace(/^en\//u, '')}`, words: entry.data.description });
  }
}
const popular = HELP_TOPICS.filter((topic) => topic.scene).map((topic) => ({
  href: topic.href,
  title: topic.title,
  desc: topic.line,
  scene: topic.scene,
  link: topic.link ?? t('site.article.read'),
}));
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  site
  schema={articleSchema({
    canonical,
    title: h1,
    description,
    locale: 'en',
    image: `${site}/og/learn-en.png`,
    published: '2026-10-30',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: t('site.nav.help'), url: canonical },
    ],
  })}
>
  <main class="at-sp at-help">
    <PageHero
      crumbs={[{ href: '/', label: t('app.name') }, { label: t('site.nav.help') }]}
      eyebrow={t('site.help.eyebrow')}
      h1={h1}
      lead={t('site.help.lead')}
      scene="maintenance"
    />
    <section class="at-sp-block" aria-label={t('site.help.searchLabel')}>
      <div
        class="at-sp-search"
        data-help
        data-one={t('site.help.one')}
        data-many={t('site.help.many')}
        data-none={t('site.help.none')}
      >
        <form role="search" action="/help" method="get">
          <label class="at-sp-search-field">
            <Lucide name="search" size={20} />
            <span class="sr-only">{t('site.help.searchLabel')}</span>
            <input type="search" name="q" placeholder={t('site.help.placeholder')} autocomplete="off" />
          </label>
        </form>
        <ul class="at-sp-chips" role="list" aria-label={t('site.help.chips')}>
          {
            HELP_CHIPS.map(([label, href]) => (
              <li>
                <a class="at-sp-chip" href={href}>
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
        <p class="at-sp-small" data-help-count aria-live="polite">{idle}</p>
        <ul class="at-sp-chips" role="list" data-help-results hidden></ul>
      </div>
      <script type="application/json" id="at-help-index" is:inline set:html={JSON.stringify(index).replaceAll('<', '\\u003c')} />
    </section>
    <Block id="help-popular" h={t('site.help.popular')}>
      <Cards items={popular} cols={3} />
    </Block>
    <Block label={t('site.help.stuck')}>
      <Callout tone="info" title={t('site.help.stuck')}>
        <span class="at-sp-body">
          {t('site.help.stuckBefore')} <a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a>
          {t('site.help.stuckAfter')}
        </span>
      </Callout>
    </Block>
  </main>
  <script>
    import { initHelpSearch } from '../lib/help-search';

    initHelpSearch();
  </script>
</BaseLayout>
