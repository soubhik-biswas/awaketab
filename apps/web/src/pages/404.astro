---
import SystemPage from '../components/site/SystemPage.astro';
import Block from '../components/site/Block.astro';
import Cards from '../components/site/Cards.astro';
import { t } from '../i18n/load';

// The not-found board: the system hero, then the guides people look for most (noindex, no ads).
const guides = [
  ['Keep your screen on while cooking', '/for/cooking', 'cooking'],
  ['Keep the screen on while presenting', '/for/presentations', 'presenting'],
  ['Keep the screen on while downloading', '/for/downloads', 'history'],
  ['Keep iPhone on in Safari', '/on/iphone-safari', undefined],
  ['iPhone Auto-Lock Never is greyed out', '/guides/iphone-auto-lock-never-greyed-out', undefined],
  ['Windows 11 screen off after 1 minute', '/guides/windows-11-screen-turns-off-after-1-minute', undefined],
] as const;
---

<SystemPage
  title={t('page.404.title')}
  description={t('page.home.description')}
  eyebrow="404"
  h1={t('site.sys.notfound.h1')}
  lead={t('site.sys.notfound.lead')}
  scene="notfound"
  primary={{ href: '/', label: t('site.cta') }}
  secondary={{ href: '/help', label: t('site.sys.help'), icon: 'life-buoy' }}
>
  <Block id="nf-guides" h={t('site.sys.notfound.guides')}>
    <Cards items={guides.map(([title, href]) => ({ href, title, desc: href, link: t('site.article.read') }))} cols={3} />
  </Block>
</SystemPage>
