---
// /about (the about board): why it exists, how it makes money, who makes it, then how it is checked, what it will not
// claim, credits and contact. Build-time markup only, no page script.
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import Block from '../components/site/Block.astro';
import DataTable from '../components/site/DataTable.astro';
import Steps from '../components/site/Steps.astro';
import { t } from '../i18n/load';
import { CONTACT_EMAIL, CONTACT_MAILTO } from '../lib/contact';
import { personSchema } from '../lib/seo';
import { LOCK_STATES } from '../lib/page-glyphs';

const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const COFFEE = 'https://buymeacoffee.com/awaketab';
const journeys = ['Acquisition', 'Denial', 'Release on hidden tabs', 'Reacquisition', 'Fallback behaviour', 'Multi-tab warnings'];
const LICENCES = {
  MIT: 'https://opensource.org/license/mit',
  'Apache 2.0': 'https://www.apache.org/licenses/LICENSE-2.0',
  'CC BY 4.0': 'https://creativecommons.org/licenses/by/4.0/',
  'SIL OFL 1.1': 'https://openfontlicense.org/',
  'CC0 1.0': 'https://creativecommons.org/publicdomain/zero/1.0/',
  ISC: 'https://opensource.org/license/isc-license-txt',
} as const;
const credits = [
  { name: 'Tone.js', href: 'https://tonejs.github.io/', use: 'Focus sounds and end sounds, made live in your browser', licence: 'MIT' },
  { name: 'howler.js', href: 'https://howlerjs.com/', use: 'Plays recorded tracks in the lo-fi library', licence: 'MIT' },
  { name: 'NumberFlow', href: 'https://number-flow.barvian.me/', use: 'The rolling digits of the Rolling face', licence: 'MIT' },
  { name: 'Embla Carousel', href: 'https://www.embla-carousel.com/', use: 'Swiping between clock faces', licence: 'MIT' },
  { name: 'Tiptap and ProseMirror', href: 'https://tiptap.dev/', use: 'The notepad editor', licence: 'MIT' },
  { name: 'idb-keyval', href: 'https://github.com/jakearchibald/idb-keyval', use: 'Keeps notes in this browser', licence: 'Apache 2.0' },
  { name: 'annyang', href: 'https://github.com/TalAter/annyang', use: 'Voice commands while you dictate a note', licence: 'MIT' },
  { name: 'vanilla-colorful', href: 'https://github.com/web-padawan/vanilla-colorful', use: 'The custom lamp colour picker', licence: 'MIT' },
  { name: 'Hero Patterns', href: 'https://heropatterns.com/', use: 'The Dots, Grid and Waves backgrounds, by Steve Schoger', licence: 'CC BY 4.0' },
  { name: 'Nixie One', href: 'https://fonts.google.com/specimen/Nixie+One', use: 'The Nixie face, by Jovanny Lemonad', licence: 'SIL OFL 1.1' },
  { name: 'DSEG', href: 'https://www.keshikan.net/fonts-e.html', use: 'The LCD face, by keshikan', licence: 'SIL OFL 1.1' },
  { name: 'Geist and Geist Mono', href: 'https://vercel.com/font', use: 'The interface type, by Vercel', licence: 'SIL OFL 1.1' },
  { name: 'Space Grotesk', href: 'https://github.com/floriankarsten/space-grotesk', use: 'The numerals of the Bold face, by Florian Karsten', licence: 'SIL OFL 1.1' },
  { name: 'Lucide', href: 'https://lucide.dev/', use: 'The interface icons, by the Lucide contributors', licence: 'ISC' },
  { name: 'SVG Logos', href: 'https://svglogos.dev/', use: 'The browser and platform logos, by Gil Barbara; logos are trademarks of their owners', licence: 'CC0 1.0' },
] as const;
const principles = [
  ['A tab is not a system setting', 'A normal browser tab cannot guarantee operation while hidden, prevent system sleep after a laptop lid closes, or override battery-saving policy.'],
  ['No fake input', 'AwakeTab does not simulate mouse movement or keystrokes and does not claim to keep chat presence indicators available.'],
  ['Nothing else on the awake screen', 'The awake screen carries no advertising or third-party scripts.'],
  ['Open to inspection', 'The core wake-lock package is developed as open-source software so its state transitions can be inspected independently.'],
] as const;
---

<BaseLayout
  title={t('page.about.title')}
  description={t('page.about.description')}
  canonical={`${site}/about`}
  ogImage="/og/about-en.png"
  schema={personSchema()}
  site
>
  <main class="at-sp at-about">
    <PageHero
      crumbs={[{ href: '/', label: t('app.name') }, { label: t('page.about.h1') }]}
      eyebrow="About"
      h1="A small tool with one job."
      lead="AwakeTab keeps a screen on while you need it and lets it sleep when you don’t. We would rather do that one thing honestly than do many things loudly."
      scene="nightdesk"
    />
    <Block id="ab-why" label="About AwakeTab">
      <div class="at-sp-prose">
        <div>
          <h2>Why it exists</h2>
          <p>
            Screens go dark at the worst moments — mid-recipe, mid-slide, mid-download. Browsers can now ask to keep the
            display on, but nothing made that simple, visible and honest. AwakeTab requests a browser wake lock, shows the
            result honestly, and makes the common timer and until-time workflows fast without requiring an account.
          </p>
        </div>
        <div>
          <h2>How we make money</h2>
          <ul>
            <li>Pro, for people who sync devices or want the extras. Keeping awake stays free.</li>
            <li>One clearly labelled ad slot on content pages — never on the timer, never animated.</li>
            <li>No selling of data. There is very little data to sell, and we keep it that way.</li>
          </ul>
        </div>
        <div>
          <h2>Who we are</h2>
          <p>
            AwakeTab is an independent project built and maintained by Soubhik Biswas. Say hello at{' '}
            <a href={CONTACT_MAILTO}>{CONTACT_EMAIL}</a>; messages go to Soubhik directly. If AwakeTab is useful, you can{' '}
            <a href={COFFEE} rel="noopener" target="_blank">buy Soubhik a coffee</a> — no widget, account or extra script,
            just a link.
          </p>
        </div>
      </div>
    </Block>

    <Block id="ab-test" h="How AwakeTab is checked" sub="Real-device results are pending until the manual run is recorded.">
      <div class="at-sp-prose">
        <p>
          The lock layer is tested as a seven-state transition machine. Browser journeys inject a controllable Wake Lock
          implementation and verify acquisition, denial, release on hidden tabs, reacquisition, fallback behaviour and
          multi-tab warnings. Device claims are kept in the support matrix and are refreshed separately from application
          code. <a href="/learn/how-we-tested">How AwakeTab is checked</a>
        </p>
      </div>
      <DataTable
        label="The seven lock states"
        cols={['Lock state', 'What the pill says']}
        template="1fr 1.6fr"
        rows={LOCK_STATES.map((id) => [{ t: id }, { t: t(`tool.pill.${id}`) }])}
      />
      <DataTable
        label="What the browser journeys verify"
        cols={['Journey', 'Checked']}
        template="1.6fr 1fr"
        rows={journeys.map((label) => [{ t: label }, { t: 'Yes', tone: 'yes' as const }])}
      />
    </Block>

    <Block id="ab-claims" h="What AwakeTab will not claim">
      <Steps items={principles.map(([title, body]) => ({ title, body }))} cols={2} />
    </Block>

    <Block id="credits" h="Credits" sub="AwakeTab stands on open-source work. Each of these loads only with the feature that uses it.">
      <DataTable
        label="Credits"
        cols={['Project', 'Used for', 'Licence']}
        template="1fr 2fr 0.8fr"
        rows={credits.map((c) => [{ t: c.name }, { t: c.use }, { t: c.licence }])}
      />
      <ul class="at-sp-chips" role="list" aria-label="Project and licence links">
        {
          credits.map((c) => (
            <li>
              <a class="at-sp-chip" href={c.href} rel="noopener" target="_blank">
                {c.name}
              </a>
            </li>
          ))
        }
        {
          Object.entries(LICENCES).map(([name, href]) => (
            <li>
              <a class="at-sp-chip" href={href} rel="noopener" target="_blank">
                {name}
              </a>
            </li>
          ))
        }
      </ul>
    </Block>

    <Block id="contact" h="Contact">
      <div class="at-sp-prose">
        <p>
          Email <a href={CONTACT_MAILTO} data-contact>{CONTACT_EMAIL}</a> for support, refunds, bug reports, device results
          that differ from the support matrix, or a request to delete your licence data. Messages go to Soubhik directly.
        </p>
      </div>
    </Block>
  </main>
</BaseLayout>
