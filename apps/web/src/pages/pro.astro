---
// Zero hydration: lib/pro-page.ts flips the launch price after its end date and sends the Pro analytics.
import BaseLayout from '../layouts/BaseLayout.astro';
import Lucide from '../components/icons/Lucide.astro';
import ProScene from '../components/pro/ProScene.astro';
import ProRefund from '../components/pro/ProRefund.astro';
import { t } from '../i18n/load';
import { articleSchema } from '../lib/seo';
import { PAYMENTS_ENABLED, POLAR_SERVER } from '../lib/checkout';
import { PLAN_PRICES, PRO_LAUNCH_END } from '../lib/license';
import { launchDay, usd } from '../lib/pro-common';
import '../styles/pro.css';

const p = (key: string, vars?: Record<string, string | number>) => t(`proflow.page.${key}`, vars);
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = '/og/pro-en.png';
const canonical = `${site}/pro`;
const launch = Date.now() < PRO_LAUNCH_END;
const yearly = usd(PLAN_PRICES.pro_yearly);
const lifeLaunch = usd(PLAN_PRICES.pro_lifetime_launch);
const lifeFull = usd(PLAN_PRICES.pro_lifetime);
const date = launchDay();

const free = [1, 2, 3, 4, 5].map((n) => p(`free.f${n}`));
const pro = [1, 2, 3, 4, 5, 6].map((n) => p(`pro.f${n}`));

type TCell = boolean | string;
const rows: Array<{ label: string; free: TCell; pro: TCell }> = [
  { label: p('cmp.awake'), free: true, pro: true },
  { label: p('cmp.lengths'), free: true, pro: true },
  { label: p('cmp.faces'), free: true, pro: true },
  { label: p('cmp.presets'), free: true, pro: true },
  { label: p('cmp.devices'), free: p('cmp.devices.free'), pro: p('cmp.devices.pro') },
  { label: p('cmp.history'), free: p('cmp.history.free'), pro: p('cmp.history.pro') },
  { label: p('cmp.sound'), free: p('cmp.sound.free'), pro: p('cmp.sound.pro') },
  { label: p('cmp.studio'), free: false, pro: true },
  { label: p('cmp.notes'), free: p('cmp.notes.free'), pro: p('cmp.notes.pro') },
  { label: p('cmp.ext'), free: p('cmp.ext.free'), pro: p('cmp.ext.pro') },
  { label: p('cmp.ads'), free: p('cmp.ads.free'), pro: p('cmp.ads.pro') },
];
const steps = [1, 2, 3].map((n) => ({ n, h: p(`how.s${n}.h`), text: p(`how.s${n}.p`) }));
const faq = [1, 2, 3, 4, 5, 6].map((n) => ({ q: p(`faq.q${n}`), a: p(`faq.a${n}`, { yearly, once: lifeFull }) }));
---

<BaseLayout
  title={p('title')}
  description={p('description', { yearly })}
  canonical={canonical}
  ogImage={ogImage}
  schema={articleSchema({
    canonical,
    title: p('h1'),
    description: p('description', { yearly }),
    locale: 'en',
    image: `${site}${ogImage}`,
    published: '2026-09-09',
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: 'Pro', url: canonical },
    ],
  })}
>
  <div class="at-pro at-pro-page" data-pro-root data-polar-server={POLAR_SERVER} data-payments={PAYMENTS_ENABLED ? 'on' : 'off'} data-launch={launch ? 'on' : 'off'} data-launch-end={String(PRO_LAUNCH_END)}>
    <div class="at-pro-glow" aria-hidden="true"></div>
    <main class="at-pro-page-main">
      <section class="at-pro-hero" aria-labelledby="pro-h1">
        <div class="at-pro-hero-text">
          <p class="at-pro-eyebrow">{p('eyebrow')}</p>
          <h1 id="pro-h1" class="at-pro-hero-h1 at-pro-hero-h1-art">{p('h1')}</h1>
          <p class="at-pro-hero-lead">{p('lead')}</p>
          {!PAYMENTS_ENABLED && <p class="at-pro-body-txt" role="status">{p('soon')}</p>}
        </div>
        <div class="at-pro-hero-art at-pro-float"><ProScene scene="success" width={520} /></div>
      </section>

      <section id="plans" class="at-pro-block" aria-label={p('plans.label')}>
        <div class="at-pro-plan-grid">
          <article class="at-pro-plan" aria-labelledby="plan-free">
            <span class="at-pro-plan-top"><h2 id="plan-free" class="at-pro-card-h3">{p('free.name')}</h2></span>
            <span class="at-pro-plan-price">{p('free.price')}</span>
            <p class="at-pro-body-txt">{p('free.d')}</p>
            <ul class="at-pro-feats">
              {free.map((f) => <li><Lucide name="check" size={18} class="at-pro-feat-icon" />{f}</li>)}
            </ul>
            <a class="at-button at-button-outline at-button-lg at-pro-plan-btn" href="/">{p('free.btn')}</a>
          </article>
          <article class="at-pro-plan at-pro-plan-pro" aria-labelledby="plan-pro">
            <span class="at-pro-plan-top"><h2 id="plan-pro" class="at-pro-card-h3">{p('pro.name')}</h2><span class="at-pro-chip">{p('pro.badge')}</span></span>
            <span class="at-pro-plan-price">{p('pro.price', { yearly })}</span>
            <p class="at-pro-body-txt">
              <span data-launch-only>{p('pro.d.launch', { once: lifeLaunch, after: lifeFull, date })}</span>
              <span data-after-only>{p('pro.d', { once: lifeFull })}</span>
            </p>
            <ul class="at-pro-feats">
              {pro.map((f) => <li><Lucide name="check" size={18} class="at-pro-feat-icon" />{f}</li>)}
            </ul>
            {
              PAYMENTS_ENABLED ? (
                <a class="at-button at-button-primary at-button-lg at-pro-plan-btn" href="/pro/checkout" data-plan="pro_yearly">{p('pro.btn')}</a>
              ) : (
                <button type="button" class="at-button at-button-primary at-button-lg at-pro-plan-btn" disabled aria-describedby="plan-pro">{p('pro.btn')}</button>
              )
            }
          </article>
        </div>
        <p class="at-pro-note">{t('page.pro.tax')} {t('page.pro.plans.shutdown')}</p>
      </section>

      <section class="at-pro-block" aria-labelledby="cmp-h">
        <h2 id="cmp-h" class="at-pro-h2">{p('cmp.h2')}</h2>
        <div class="at-pro-table" role="region" aria-labelledby="cmp-h" tabindex="0">
          <table>
            <thead>
              <tr>
                <th scope="col">{p('cmp.col.feature')}</th>
                <th scope="col">{p('free.name')}</th>
                <th scope="col">{p('pro.name')}</th>
              </tr>
            </thead>
            <tbody>
              {
                rows.map((r) => (
                  <tr>
                    <th scope="row">{r.label}</th>
                    {[r.free, r.pro].map((v) => (
                      <td>
                        {typeof v === 'string' ? (
                          v
                        ) : v ? (
                          <span class="at-pro-yes"><Lucide name="check" size={16} />{p('cmp.yes')}</span>
                        ) : (
                          <span class="at-pro-no"><Lucide name="minus" size={16} />{p('cmp.no')}</span>
                        )}
                      </td>
                    ))}
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </section>

      <section class="at-pro-block" aria-labelledby="how-h">
        <h2 id="how-h" class="at-pro-h2">{p('how.h2')}</h2>
        <p class="at-pro-sub">{p('how.lead')}</p>
        <ol class="at-pro-steps">
          {
            steps.map((s) => (
              <li class="at-pro-step">
                <span class="at-pro-step-n" aria-hidden="true">{s.n}</span>
                <h3 class="at-pro-card-h3">{s.h}</h3>
                <p class="at-pro-body-txt">{s.text}</p>
              </li>
            ))
          }
        </ol>
        <p class="at-pro-links">
          <a class="at-pro-inline-link" href="/pro/activate">{t('pro.activate')}</a>
          <a class="at-pro-inline-link" href="/pro/manage">{t('page.pro.activate.manage')}</a>
          <a class="at-pro-inline-link" href="/signin">{p('how.signin')}</a>
        </p>
      </section>

      <section class="at-pro-block" aria-labelledby="faq-h">
        <h2 id="faq-h" class="at-pro-h2">{p('faq.h2')}</h2>
        <div class="at-pro-faq">
          {
            faq.map((q, i) => (
              <details name="pro-faq" open={i === 0}>
                <summary>
                  <span class="at-pro-faq-q">{q.q}</span>
                  <Lucide name="chevron-down" size={20} class="at-pro-faq-icon" />
                </summary>
                <p class="at-pro-body-txt">{q.a}</p>
              </details>
            ))
          }
        </div>
        <ProRefund />
      </section>

      <section class="at-pro-block" aria-labelledby="biz-h">
        <h2 id="biz-h" class="at-pro-h2">{t('page.pro.biz.h2')}</h2>
        <div class="at-pro-biz">
          <a class="at-pro-biz-card" href="/embed">
            <span class="at-pro-biz-top"><strong class="at-pro-card-h3">{t('page.pro.biz.embed')}</strong><span class="at-pro-help-txt">{t('page.pro.biz.embed.price', { price: usd(PLAN_PRICES.biz_embed_site_yearly) })}</span></span>
            <span class="at-pro-body-txt">{t('page.pro.biz.embed.text')}</span>
          </a>
          <a class="at-pro-biz-card" href="/kiosk">
            <span class="at-pro-biz-top"><strong class="at-pro-card-h3">{t('page.pro.biz.kiosk')}</strong><span class="at-pro-help-txt">{t('page.pro.biz.kiosk.price', { one: usd(PLAN_PRICES.biz_kiosk_site), five: usd(PLAN_PRICES.biz_kiosk_5) })}</span></span>
            <span class="at-pro-body-txt">{t('page.pro.biz.kiosk.text')}</span>
          </a>
        </div>
      </section>
    </main>
  </div>
  <script>
    import { bootProPage } from '../lib/pro-page';
    const root = document.querySelector<HTMLElement>('[data-pro-root]');
    if (root) bootProPage(root);
  </script>
</BaseLayout>
