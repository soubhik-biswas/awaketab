---
// Sign-in for Pro sync: empty, error, sent, plus the link landing states (verifying, signed in, expired).
import BaseLayout from '../layouts/BaseLayout.astro';
import Lucide from '../components/icons/Lucide.astro';
import ProScene from '../components/pro/ProScene.astro';
import { t } from '../i18n/load';
import { SIGNIN_MINUTES } from '../lib/account';
import '../styles/pro.css';

const s = (key: string, vars?: Record<string, string | number>) => t(`account.signin.${key}`, vars);
const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const minutes = { minutes: SIGNIN_MINUTES };
---

<BaseLayout title={s('title')} description={s('description')} canonical={`${site}/signin`} noindex>
  <div class="at-pro at-pro-page" data-signin-root data-state="form">
    <div class="at-pro-glow" aria-hidden="true"></div>
    <main class="at-pro-page-main">
      <section class="at-pro-hero" aria-labelledby="signin-h1">
        <div class="at-pro-hero-text">
          <p class="at-pro-eyebrow" data-for="form sent unavailable">{s('eyebrow')}</p>
          <p class="at-pro-eyebrow" data-for="expired">{s('expired.eyebrow')}</p>
          <p class="at-pro-eyebrow" data-for="signed verifying">{s('signed.eyebrow')}</p>
          <h1 id="signin-h1" class="at-pro-hero-h1" tabindex="-1">
            <span data-for="form sent unavailable">{s('h1')}</span>
            <span data-for="expired">{s('expired.h1')}</span>
            <span data-for="verifying">{s('verifying.h1')}</span>
            <span data-for="signed">{s('signed.h1')}</span>
          </h1>
          <p class="at-pro-hero-lead" data-for="form sent unavailable">{s('lead')}</p>
          <p class="at-pro-hero-lead" data-for="expired">{s('expired.lead', minutes)}</p>
          <p class="at-pro-hero-lead" data-for="signed">{s('signed.lead')}</p>
          <div class="at-pro-hero-actions" data-for="expired">
            <button type="button" class="at-button at-button-primary at-button-xl at-pro-btn-xl" data-signin-again>
              <Lucide name="mail" size={20} />{s('expired.again')}
            </button>
            <a class="at-button at-button-outline at-button-xl at-pro-btn-xl" href="/">{s('expired.home')}</a>
          </div>
        </div>
        <div class="at-pro-hero-art" data-for="expired"><ProScene scene="expired" width={520} /></div>
      </section>

      <section class="at-pro-block" data-for="form sent unavailable verifying signed">
        <div class="at-pro-form-card">
          <form class="at-pro-form" data-signin-form data-for="form unavailable" novalidate>
            <label class="at-pro-field">
              <span class="at-pro-field-label">{s('label')}</span>
              <input
                class="at-pro-input"
                type="email"
                name="email"
                placeholder="you@example.com"
                autocomplete="email"
                inputmode="email"
                spellcheck="false"
                maxlength="254"
                required
                aria-describedby="signin-help"
                data-signin-email
              />
            </label>
            <p id="signin-help" class="at-pro-help" data-signin-help aria-live="polite">
              <Lucide name="circle-alert" size={16} class="at-pro-help-icon" />
              <span data-signin-help-text data-idle={s('help')} data-bad={s('error.email')} data-rate={s('error.rate')} data-offline={s('error.offline')}>{s('help')}</span>
            </p>
            <button type="submit" class="at-button at-button-primary at-button-lg at-pro-btn-form" data-signin-submit>
              <Lucide name="mail" size={18} />
              <span data-label-idle>{s('submit')}</span>
              <span data-label-busy>{s('sending')}</span>
            </button>
            <p class="at-pro-form-note">{s('note', minutes)}</p>
            <div class="at-pro-callout at-pro-callout-warn" role="alert" data-for="unavailable">
              <Lucide name="triangle-alert" size={20} class="at-pro-callout-icon" />
              <span class="at-pro-callout-text">
                <strong>{s('unavailable.title')}</strong>
                <span>{s('unavailable.text')} <a class="at-pro-inline-link" href="/pro/activate">{s('unavailable.link')}</a></span>
              </span>
            </div>
          </form>

          <div class="at-pro-sent" role="status" aria-live="polite" data-for="sent">
            <ProScene scene="success" width={240} />
            <h2 class="at-pro-card-h3" tabindex="-1" data-sent-heading>{s('sent.h')}</h2>
            <p class="at-pro-body-txt">
              {s('sent.before')} <strong data-sent-email></strong>{s('sent.after')}
            </p>
            <button type="button" class="at-pro-link-btn" data-signin-reset>{s('sent.reset')}</button>
          </div>

          <div class="at-pro-sent" role="status" aria-live="polite" data-for="verifying">
            <Lucide name="loader-circle" size={24} class="at-pro-spin" />
            <p class="at-pro-body-txt">{s('verifying.text')}</p>
          </div>

          <div class="at-pro-signed" data-for="signed">
            <span class="at-pro-avatar" aria-hidden="true"><Lucide name="user" size={20} /></span>
            <span class="at-pro-signed-who">
              <strong data-signed-email></strong>
              <span class="at-pro-help-txt">{s('signed.how')}</span>
            </span>
            <div class="at-pro-signed-actions">
              <a class="at-button at-button-primary at-button-lg" href="/">{s('signed.open')}</a>
              <button type="button" class="at-button at-button-outline at-button-lg" data-signin-out>
                <Lucide name="log-out" size={18} />{s('signed.out')}
              </button>
            </div>
          </div>
        </div>
      </section>

      <section class="at-pro-block" data-for="form sent unavailable">
        <div class="at-pro-callout at-pro-callout-info" role="note">
          <Lucide name="info" size={20} class="at-pro-callout-icon" />
          <span class="at-pro-callout-text">
            <strong>{s('callout.title')}</strong>
            <span>{s('callout.text')}</span>
          </span>
        </div>
      </section>
    </main>
  </div>
  <script>
    import { bootSigninPage } from '../lib/signin-page';
    const root = document.querySelector<HTMLElement>('[data-signin-root]');
    if (root) bootSigninPage(root);
  </script>
</BaseLayout>
