---
// /changelog (the changelog board). Fragments are the `changelog` content collection (repo-root `changelog/*.md`),
// rendered at build time by Astro's Markdown pipeline: no client JS (F-07, docs/14 §7). The release summary heads the
// page as its own card; the rest are release cards grouped by date with a New / Fixed / Changed tag from front
// matter. The filter is four native radios; CSS (:has) hides what does not match, so it works without a script.
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/site/PageHero.astro';
import { t } from '../i18n/load';
import {
  changelogDate,
  changelogLongDate,
  groupByDate,
  inlineMarkdown,
  releaseParts,
  sortChangelog,
  type TChangelogType,
} from '../lib/changelog';
import { articleSchema } from '../lib/seo';

const sorted = sortChangelog(await getCollection('changelog'));
const entries = await Promise.all(
  sorted.map(async (entry) => ({
    id: entry.id,
    title: entry.data.title,
    date: changelogDate(entry.data.date),
    release: entry.data.release,
    type: (entry.data.type ?? 'new') as TChangelogType,
    body: entry.body ?? '',
    Content: (await render(entry)).Content,
  })),
);
const release = entries.find((e) => e.release !== undefined);
const rest = entries.filter((e) => e !== release);
const groups = groupByDate(rest);
const parts = release ? releaseParts(release.body) : null;
const latest = entries[0]?.date;

const LABEL: Record<TChangelogType, string> = { new: 'New', fixed: 'Fixed', changed: 'Changed' };
const count = (type: TChangelogType) => rest.filter((e) => e.type === type).length + (type === 'new' && release ? 1 : 0);
const filters = [
  { value: 'all', label: 'All', count: entries.length },
  { value: 'new', label: 'New', count: count('new') },
  { value: 'fixed', label: 'Fixed', count: count('fixed') },
  { value: 'changed', label: 'Changed', count: count('changed') },
].map((f) => ({ ...f, aria: `${f.label}, ${String(f.count)} changes` }));

const site = Astro.site?.toString().replace(/\/$/u, '') ?? 'https://awaketab.com';
const ogImage = '/og/changelog-en.png';
const canonical = `${site}/changelog`;
---

<BaseLayout
  title={t('page.changelog.title')}
  description={t('page.changelog.description')}
  canonical={canonical}
  ogImage={ogImage}
  site
  schema={articleSchema({
    canonical,
    title: t('page.changelog.h1'),
    description: t('page.changelog.description'),
    locale: 'en',
    image: `${site}${ogImage}`,
    published: '2026-09-09',
    ...(latest ? { updated: latest } : {}),
    breadcrumbs: [
      { name: 'AwakeTab', url: site },
      { name: t('page.changelog.h1'), url: canonical },
    ],
  })}
>
  <main class="at-sp at-cl">
    <PageHero
      crumbs={[{ href: '/', label: t('app.name') }, { label: t('page.changelog.h1') }]}
      eyebrow="Changelog"
      h1={t('page.changelog.h1')}
      lead={t('page.changelog.description')}
    >
      <fieldset class="at-sp-filter">
        <legend class="sr-only">Show changes</legend>
        <ul class="at-sp-chips" role="list">
          {
            filters.map((f) => (
              <li>
                <label class="at-sp-chip">
                  <input class="sr-only" type="radio" name="cl-filter" value={f.value} checked={f.value === 'all'} aria-label={f.aria} />
                  <span aria-hidden="true">
                    {f.label} · {f.count}
                  </span>
                </label>
              </li>
            ))
          }
        </ul>
      </fieldset>
    </PageHero>

    <div class="at-sp-block">
      {
        release && parts && (
          <article class="at-sp-rel at-cl-release" aria-labelledby="cl-release" data-changelog-entry={release.id} data-date={release.date} data-type="new">
            <span class="at-sp-rel-top">
              <span class="at-sp-tag" data-tone="new">Release {release.release}</span>
              <time class="at-sp-ver" datetime={release.date}>{changelogLongDate(release.date)}</time>
            </span>
            <h2 id="cl-release" class="at-sp-h3" data-changelog-title>
              {release.title}
            </h2>
            <p class="at-sp-body" set:html={inlineMarkdown(parts.lede)} />
            {parts.parts.length > 0 && (
              <ul>
                {parts.parts.map((p) => (
                  <li>
                    <strong>{p.head}:</strong> <Fragment set:html={inlineMarkdown(p.body)} />
                  </li>
                ))}
              </ul>
            )}
            {parts.rest.map((p) => (
              <p class="at-sp-body" set:html={inlineMarkdown(p)} />
            ))}
          </article>
        )
      }
    </div>

    <ol class="at-sp-block at-cl-groups" aria-label="Changes by date">
      {
        groups.map((g) => (
          <li class="at-cl-group">
            <h2 class="at-cl-date"><time datetime={g.date}>{changelogLongDate(g.date)}</time></h2>
            <ol class="at-sp-releases" role="list">
              {g.items.map((e) => (
                <li class="at-cl-entry" data-changelog-entry={e.id} data-date={e.date} data-type={e.type}>
                  <article class="at-sp-rel">
                    <span class="at-sp-rel-top">
                      <span class="at-sp-tag" data-tone={e.type}>
                        {LABEL[e.type]}
                      </span>
                      <span class="at-sp-ver">{changelogLongDate(e.date)}</span>
                    </span>
                    <h3 class="at-sp-h3" data-changelog-title>
                      {e.title}
                    </h3>
                    <div class="at-sp-body at-cl-body">
                      <e.Content />
                    </div>
                  </article>
                </li>
              ))}
            </ol>
          </li>
        ))
      }
    </ol>
  </main>
</BaseLayout>
