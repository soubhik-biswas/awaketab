---
import SystemPage from '../components/site/SystemPage.astro';
import { t } from '../i18n/load';
---

<SystemPage
  title={t('site.sys.error.title')}
  description={t('site.sys.error.lead')}
  eyebrow={t('site.sys.error.eyebrow')}
  h1={t('site.sys.error.h1')}
  lead={t('site.sys.error.lead')}
  scene="error"
  primary={{ href: '', label: t('site.sys.retry'), icon: 'refresh-cw' }}
  secondary={{ href: '/', label: t('site.cta'), icon: 'play' }}
/>
