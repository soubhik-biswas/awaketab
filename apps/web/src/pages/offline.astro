---
import SystemPage from '../components/site/SystemPage.astro';
import { t } from '../i18n/load';

// The service worker opens this cached page for an uncached page while offline (src/sw-fallback.ts). "Try again"
// is a link to the address itself, so it reloads the page that failed.
---

<SystemPage
  title={t('site.sys.offline.title')}
  description={t('site.sys.offline.lead')}
  eyebrow={t('site.sys.offline.eyebrow')}
  h1={t('site.sys.offline.h1')}
  lead={t('site.sys.offline.lead')}
  scene="offline"
  primary={{ href: '/', label: t('site.sys.offline.timer') }}
  secondary={{ href: '', label: t('site.sys.retry'), icon: 'refresh-cw' }}
/>
